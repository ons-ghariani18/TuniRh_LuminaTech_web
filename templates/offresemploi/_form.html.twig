{# templates/offresemploi/_form.html.twig #}
{{ form_start(form, {'attr': {'class': 'form-offresemploi'}}) }}
    <div class="form-group">
        <label for="{{ form.titre.vars.id }}">Titre</label>
        {{ form_widget(form.titre, {'attr': {'class': 'form-control', 'placeholder': 'Ex. Développeur Web'}}) }}
        <div class="invalid-feedback"></div>
    </div>

    <div class="form-group">
        <label for="{{ form.description.vars.id }}">Description</label>
        {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': '5', 'placeholder': 'Décrivez les responsabilités...'}}) }}
        <div class="invalid-feedback"></div>
    </div>

    <div class="form-group">
        <label for="{{ form.competences_requises.vars.id }}">Compétences Requises</label>
        {{ form_widget(form.competences_requises, {'attr': {'class': 'form-control', 'placeholder': 'Ex. PHP, Symfony, JavaScript'}}) }}
        <div class="invalid-feedback"></div>
    </div>

    <div class="form-group">
        <label for="{{ form.lieu.vars.id }}">Lieu</label>
        {{ form_widget(form.lieu, {'attr': {'class': 'form-control', 'placeholder': 'Ex. Paris'}}) }}
        <div class="invalid-feedback"></div>
    </div>

    <div class="form-group">
        <label for="{{ form.type_contrat.vars.id }}">Type de Contrat</label>
        {{ form_widget(form.type_contrat, {'attr': {'class': 'form-control'}}) }}
        <div class="invalid-feedback"></div>
    </div>

    <div class="form-group">
        <label for="{{ form.statut.vars.id }}">Statut</label>
        {{ form_widget(form.statut, {'attr': {'class': 'form-control'}}) }}
        <div class="invalid-feedback"></div>
    </div>

    <div class="form-group">
        <label for="{{ form.date_publication.vars.id }}">Date de Publication</label>
        {{ form_widget(form.date_publication, {'attr': {'class': 'form-control datepicker'}}) }}
        <div class="invalid-feedback"></div>
    </div>

    <div class="flex gap-4">
        <button type="submit" class="btn-primary">
            <i class="mdi mdi-content-save"></i> {{ button_label|default('Créer') }}
        </button>
        <a href="{{ path('app_offresemploi_index') }}" class="btn-secondary">
            <i class="mdi mdi-cancel"></i> Annuler
        </a>
    </div>
{{ form_end(form) }}