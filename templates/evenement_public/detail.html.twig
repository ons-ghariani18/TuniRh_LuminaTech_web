{% extends 'base.html.twig' %}

{% block title %}{{ evenement.nom }} - Détails de l'événement{% endblock %}

{% block stylesheets %}
<style>
/* Root variables for consistent theming */
:root {
    --primary-navy: #091E3E;
    --primary-blue: #091E3E; /* Nouvelle couleur bleue */
    --primary-orange: #ff7a00;
    --secondary-orange: #ff9e4f;
    --light-orange: #ffe0c2;
    --background-light: #f8f9fa;
    --white: #ffffff;
    --text-dark: #1a2a44;
    --text-muted: #6c757d;
    --shadow: rgba(9, 30, 62, 0.15);
}

/* General styles */
.event-bg {
    background-color: var(--background-light);
    position: relative;
    overflow: hidden;
}

.event-bg::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 300px;
    background: var(--primary-blue); /* Bleu uni */
    z-index: 0;
    clip-path: polygon(0 0, 100% 0, 100% 80%, 0 100%);
}

.container {
    position: relative;
    z-index: 1;
    max-width: 1200px;
}

/* Breadcrumb */
.breadcrumb {
    background: rgba(255, 255, 255, 0.15);
    padding: 12px 20px;
    border-radius: 12px;
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.2);
}

.breadcrumb-item a {
    color: var(--white) !important;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.3s ease;
}

.breadcrumb-item a:hover {
    color: var(--light-orange) !important;
}

.breadcrumb-item.active {
    color: var(--light-orange);
    font-weight: 600;
}

/* Event Card */
.event-card {
    background: var(--white);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border-radius: 16px !important;
}

.event-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px var(--shadow) !important;
}

.event-image {
    transition: transform 0.6s ease;
    border-radius: 16px 16px 0 0;
}

.event-card:hover .event-image {
    transform: scale(1.08);
}

.event-type-badge {
    background: var(--primary-orange);
    color: var(--white);
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 20px;
    box-shadow: 0 4px 12px rgba(255, 122, 0, 0.3);
    transition: all 0.3s ease;
}

.event-type-badge:hover {
    transform: translateY(-3px);
    background: var(--secondary-orange);
    box-shadow: 0 6px 15px rgba(255, 122, 0, 0.4);
}

/* Icon Circles */
.icon-circle {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--primary-navy);
    font-size: 1.3rem;
    box-shadow: 0 4px 12px var(--shadow);
    transition: all 0.3s ease;
}

.icon-circle:hover {
    background: var(--light-orange);
    color: var(--primary-orange);
    transform: scale(1.1);
}

/* Event Title Container */
.event-title-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
    position: relative;
    padding-bottom: 15px;
}

.event-title-container:after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 80px;
    height: 4px;
    background: var(--primary-blue);
}

/* Event Title */
.event-title {
    color: var(--primary-navy);
    font-size: 2rem;
    font-weight: 700;
    margin: 0;
}

/* Detail Icon */
.detail-icon-circle {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background-color: var(--light-orange);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--primary-orange);
    margin-left: 15px;
    flex-shrink: 0;
    transition: all 0.3s ease;
    box-shadow: 0 4px 8px rgba(255, 122, 0, 0.2);
}

.detail-icon-circle:hover {
    background-color: var(--primary-orange);
    color: var(--white);
    transform: translateY(-2px) scale(1.1);
    box-shadow: 0 6px 12px rgba(255, 122, 0, 0.4);
}

/* Buttons */
.register-btn {
    background: var(--primary-orange);
    color: var(--white);
    border: none;
    border-radius: 30px;
    padding: 12px 24px;
    font-weight: 600;
    box-shadow: 0 6px 15px var(--shadow);
    transition: all 0.3s ease;
}

.register-btn:hover {
    background: var(--secondary-orange);
    box-shadow: 0 8px 20px rgba(255, 122, 0, 0.35);
    transform: translateY(-3px);
    color: var(--white);
}

.share-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--white);
    transition: all 0.3s ease;
    box-shadow: 0 4px 12px var(--shadow);
}

.share-btn:hover {
    transform: translateY(-4px) scale(1.1);
    box-shadow: 0 6px 15px rgba(0, 0, 0, 0.2);
}

.view-all-btn {
    background: transparent;
    border: 2px solid var(--primary-blue);
    color: var(--primary-blue);
    font-weight: 600;
    border-radius: 30px;
    padding: 12px 24px;
    transition: all 0.3s ease;
}

.view-all-btn:hover {
    background: var(--primary-blue);
    color: var(--white);
    box-shadow: 0 6px 15px var(--shadow);
}

/* List Group */
.list-group-item {
    padding: 14px 0;
    background: transparent;
    transition: all 0.3s ease;
}

.list-group-item:hover {
    transform: translateX(8px);
}

.list-group-item i {
    color: var(--primary-navy);
    transition: all 0.3s ease;
}

.list-group-item:hover i {
    color: var(--primary-orange);
    transform: scale(1.15);
}

/* Animations */
.fade-in {
    opacity: 0;
    animation: fadeIn 1s ease forwards;
}

.slide-up {
    opacity: 0;
    transform: translateY(40px);
    animation: slideUp 1s ease forwards;
}

@keyframes fadeIn {
    to { opacity: 1; }
}

@keyframes slideUp {
    to { 
        opacity: 1;
        transform: translateY(0);
    }
}

/* Responsive Adjustments */
@media (max-width: 991px) {
    .event-bg::before {
        height: 200px;
        clip-path: polygon(0 0, 100% 0, 100% 60%, 0 80%);
    }

    .event-title {
        font-size: 1.75rem;
    }
}

@media (max-width: 767px) {
    .event-bg::before {
        height: 150px;
    }

    .icon-circle {
        width: 40px;
        height: 40px;
        font-size: 1.1rem;
    }

    .event-title {
        font-size: 1.5rem;
    }

    .register-btn {
        padding: 10px 20px;
        font-size: 0.9rem;
    }

    .share-btn {
        width: 38px;
        height: 38px;
    }
    
    .detail-icon-circle {
        width: 36px;
        height: 36px;
    }
}

@media (max-width: 575px) {
    .breadcrumb {
        padding: 10px 15px;
        font-size: 0.85rem;
    }

    .event-image {
        height: 250px;
    }

    .event-card {
        border-radius: 12px !important;
    }
}
</style>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Elements to animate on page load
    const elementsToAnimate = [
        { element: document.querySelector('nav.breadcrumb'), class: 'fade-in', delay: 100 },
        { element: document.querySelector('.col-lg-5 .card'), class: 'slide-up', delay: 200 },
        { element: document.querySelector('.col-lg-7 .card'), class: 'slide-up', delay: 400 },
        { element: document.querySelector('.mt-5.pt-3'), class: 'fade-in', delay: 600 }
    ];

    // Apply animations with delays
    elementsToAnimate.forEach(item => {
        if (item.element) {
            setTimeout(() => {
                item.element.classList.add(item.class);
            }, item.delay);
        }
    });

    // Add interactive effects
    addInteractiveEffects();
    
    // Initialize share buttons
    initShareButtons();
    
    // Add smooth scroll for anchor links
    addSmoothScroll();
});

// Function for additional interactive effects
function addInteractiveEffects() {
    // Add ripple effect to buttons (excluding register-btn to avoid interference)
    const buttons = document.querySelectorAll('.btn:not(.register-btn)');
    buttons.forEach(button => {
        button.addEventListener('click', function(e) {
            const rect = button.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            
            const ripple = document.createElement('span');
            ripple.style.left = `${x}px`;
            ripple.style.top = `${y}px`;
            
            ripple.style.position = 'absolute';
            ripple.style.background = 'rgba(255, 255, 255, 0.7)';
            ripple.style.borderRadius = '50%';
            ripple.style.transform = 'scale(0)';
            ripple.style.animation = 'ripple 0.6s linear';
            ripple.style.pointerEvents = 'none';
            
            button.style.position = 'relative';
            button.style.overflow = 'hidden';
            
            button.appendChild(ripple);
            
            setTimeout(() => {
                ripple.remove();
            }, 700);
        });
    });
    
    // Animate icon circles on hover
    const iconCircles = document.querySelectorAll('.icon-circle');
    iconCircles.forEach(circle => {
        circle.addEventListener('mouseenter', function() {
            const icon = this.querySelector('i');
            if (icon) {
                icon.style.transition = 'transform 0.3s ease';
                icon.style.transform = 'scale(1.2)';
            }
        });
        
        circle.addEventListener('mouseleave', function() {
            const icon = this.querySelector('i');
            if (icon) {
                icon.style.transform = 'scale(1)';
            }
        });
    });
    
    // Add parallax effect to event image on mouse move
    const eventCard = document.querySelector('.event-card');
    const eventImage = document.querySelector('.event-image');
    
    if (eventCard && eventImage) {
        eventCard.addEventListener('mousemove', function(e) {
            const rect = eventCard.getBoundingClientRect();
            const x = (e.clientX - rect.left) / rect.width;
            const y = (e.clientY - rect.top) / rect.height;
            
            eventImage.style.transform = `scale(1.05) translateX(${x * 10 - 5}px) translateY(${y * 10 - 5}px)`;
        });
        
        eventCard.addEventListener('mouseleave', function() {
            eventImage.style.transform = 'scale(1)';
        });
    }
}

// Function to initialize share buttons
function initShareButtons() {
    const shareButtons = document.querySelectorAll('.share-btn');
    
    shareButtons.forEach(button => {
        button.addEventListener('click', function(e) {
            e.preventDefault();
            
            const url = window.location.href;
            const title = document.querySelector('.event-title').textContent;
            
            // Determine which social media platform was clicked
            if (this.querySelector('.fa-facebook-f')) {
                window.open(`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`, 'facebook-share');
            } else if (this.querySelector('.fa-twitter')) {
                window.open(`https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`, 'twitter-share');
            } else if (this.querySelector('.fa-linkedin-in')) {
                window.open(`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`, 'linkedin-share');
            } else if (this.querySelector('.fa-whatsapp')) {
                window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(title + ' ' + url)}`, 'whatsapp-share');
            }
        });
    });
}

// Function for smooth scrolling
function addSmoothScroll() {
    const links = document.querySelectorAll('a[href^="#"]');
    
    links.forEach(link => {
        link.addEventListener('click', function(e) {
            const href = this.getAttribute('href');
            
            if (href !== "#") {
                e.preventDefault();
                const target = document.querySelector(href);
                
                if (target) {
                    window.scrollTo({
                        top: target.offsetTop - 100,
                        behavior: 'smooth'
                    });
                }
            }
        });
    });
}

// Add keyframes for ripple effect to document
(function addKeyframes() {
    const style = document.createElement('style');
    style.textContent = `
        @keyframes ripple {
            to {
                transform: scale(15);
                opacity: 0;
            }
        }
    `;
    document.head.appendChild(style);
})();
</script>
{% endblock %}

