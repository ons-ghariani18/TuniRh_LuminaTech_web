{% extends 'base.html.twig' %}

{% block title %}Test QR Code{% endblock %}

{% block body %}
    <h1>Test de génération de QR Code</h1>
    
    <div class="qr-test-container">
        <p>Contenu encodé : <strong>{{ qrContent }}</strong></p>
        <img src="{{ qrCode }}" alt="QR Code de test" style="border: 1px solid #ddd; padding: 10px;">
        <p class="text-muted">Si le QR Code s'affiche ci-dessus, la génération fonctionne.</p>
    </div>
{% endblock %}