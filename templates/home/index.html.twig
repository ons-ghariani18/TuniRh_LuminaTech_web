    }
    
    .feature-circle-animation {
        position: absolute;
        width: 300px;
        height: 300px;
        border-radius: 50%;
        border: 2px dashed rgba(26, 43, 71, 0.15);
        animation: rotate 20s linear infinite;
        z-index: 1;
