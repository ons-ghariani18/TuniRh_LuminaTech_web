        transform: scale(0.95) translateY(0);
        filter: grayscale(100%) contrast(0.8);
    }
    
    .sponsor-item:hover {
        transform: scale(1.05) !important;
        filter: grayscale(0%) contrast(1) !important;
        box-shadow: 0 8px 25px rgba(78, 84, 200, 0.3);
    }
    
    .sponsor-item img {
        max-height: 70px;
