<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Enhanced carousel initialization
        $('.sponsor-carousel').owlCarousel({
            loop: true,
            margin: 30,
            nav: false,
            dots: false,
            autoplay: true,
            autoplayTimeout: 2500,
            autoplayHoverPause: true,
            smartSpeed: 800,
            responsive: {
                0: { items: 2 },
                576: { items: 3 },
                768: { items: 4 },
                992: { items: 5 },
                1200: { items: 6 }
            }
        });
        
        // Advanced scroll animation with Intersection Observer
        const sponsorItems = document.querySelectorAll('.sponsor-item');
        
        const observerOptions = {
            threshold: 0.2,
            rootMargin: '0px 0px -50px 0px'
        };
        
        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry, index) => {
                if (entry.isIntersecting) {
                    setTimeout(() => {
                        entry.target.classList.add('animated');
                        
                        // Add color splash effect on first appearance
                        if (!entry.target.dataset.animated) {
                            entry.target.dataset.animated = true;
                            const rect = entry.target.getBoundingClientRect();
                            const x = rect.left + rect.width/2;
                            const y = rect.top + rect.height/2;
                            
                            const ripple = document.createElement('div');
                            ripple.style.position = 'absolute';
                            ripple.style.width = '10px';
                            ripple.style.height = '10px';
                            ripple.style.borderRadius = '50%';
                            ripple.style.background = 'radial-gradient(circle, rgba(143,148,251,0.5) 0%, rgba(255,255,255,0) 70%)';
                            ripple.style.transform = 'scale(0)';
                            ripple.style.left = `${x}px`;
                            ripple.style.top = `${y}px`;
                            ripple.style.pointerEvents = 'none';
                            ripple.style.zIndex = '5';
                            ripple.style.transition = 'transform 1s ease-out, opacity 1s ease-out';
                            
                            document.body.appendChild(ripple);
                            
                            setTimeout(() => {
                                ripple.style.transform = 'scale(20)';
                                ripple.style.opacity = '0';
                            }, 10);
                            
                            setTimeout(() => {
                                ripple.remove();
                            }, 1000);
                        }
                    }, index * 150);
                }
            });
        }, observerOptions);
        
        sponsorItems.forEach(item => {
            observer.observe(item);
        });
        
        // Enhanced hover effects
        $('.sponsor-item').hover(
            function() {
                $(this).css({
                    'transform': 'scale(1.05)',
                    'filter': 'grayscale(0%) contrast(1)',
                    'box-shadow': '0 8px 25px rgba(78, 84, 200, 0.3)'
                });
                
                // Add subtle tilt effect
                $(this).css('transform', 'scale(1.05) rotate(1deg)');
                
                // Add color glow
                $(this).append('<div class="sponsor-glow"></div>');
                $('.sponsor-glow').css({
                    'position': 'absolute',
                    'top': '0',
                    'left': '0',
                    'width': '100%',
                    'height': '100%',
                    'border-radius': '8px',
                    'background': 'radial-gradient(circle at center, rgba(143, 148, 251, 0.2) 0%, transparent 70%)',
                    'z-index': '-1',
                    'opacity': '0',
                    'transition': 'opacity 0.3s ease'
                });
                
                setTimeout(() => {
                    $('.sponsor-glow').css('opacity', '1');
                }, 10);
            },
            function() {
                $(this).css({
                    'transform': 'scale(0.95)',
                    'filter': 'grayscale(100%) contrast(0.8)',
                    'box-shadow': '0 5px 15px rgba(0, 0, 0, 0.05)'
                });
                
                // Remove tilt effect
                $(this).css('transform', 'scale(0.95) rotate(0)');
                
                // Remove glow
                $('.sponsor-glow').remove();
            }
        );
    });
</script>


    

