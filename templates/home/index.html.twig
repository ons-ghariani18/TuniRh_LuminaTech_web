<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Animate steps on scroll
        const steps = document.querySelectorAll('.step-card');
        
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const step = entry.target;
                    const stepNumber = step.getAttribute('data-step');
                    
                    // Add animation class
                    step.classList.add('animate-step');
                    
                    // Animate progress bar
                    if (stepNumber < 4) {
                        const progress = step.querySelector('.step-progress');
                        setTimeout(() => {
                            progress.querySelector('::after').style.width = '100%';
                        }, 300);
                    }
                }
            });
        }, { threshold: 0.5 });
        
        steps.forEach(step => observer.observe(step));
        
        // Button hover effect
        const startButton = document.querySelector('.btn-start-evaluation');
        if (startButton) {
            startButton.addEventListener('mouseenter', () => {
                startButton.style.animation = 'pulse 1.5s infinite';
            });
            
            startButton.addEventListener('mouseleave', () => {
                startButton.style.animation = 'none';
            });
        }
    });
</script>








