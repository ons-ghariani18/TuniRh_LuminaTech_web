    .sponsor-dots {
        position: absolute;
        width: 150%;
        height: 150%;
        background-image: radial-gradient(rgba(78, 84, 200, 0.1) 2px, transparent 2px);
        background-size: 30px 30px;
        animation: moveDots 120s linear infinite;
        opacity: 0.5;
