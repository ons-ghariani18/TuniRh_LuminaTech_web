        position: relative;
        overflow: hidden;
        border: none;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(5px);
        transition: all 0.5s ease;
        z-index: 1;
    }
    
    .sponsors-container:hover {
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.2);
        transform: translateY(-5px);
    }
    
    /* Sponsor item styling */
    .sponsor-carousel {
        position: relative;
        z-index: 2;
    }
    
    .sponsor-item {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 140px;
        padding: 25px;
        margin: 0 15px;
        background: white;
        border-radius: 12px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
