        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.6s ease;
    }
    
    .feature-card:hover .feature-line {
        transform: scaleX(1);
    }
    
    /* Feature Image */
    .feature-image-col {
        position: relative;
        z-index: 1;
    }
    
    .feature-image-container {
        position: relative;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
