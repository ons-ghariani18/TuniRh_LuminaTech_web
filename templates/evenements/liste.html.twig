{% extends 'base.html.twig' %}

{% block title %}Tous nos événements{% endblock %}

{% block stylesheets %}
<style>
:root {
    --primary-navy: #091E3E;
    --primary-orange: #ff7a00;
    --secondary-orange: #ff9e4f;
    --light-orange: #ffe0c2;
    --background-light: #f8f9fa;
    --white: #ffffff;
    --text-dark: #1a2a44;
    --text-muted: #6c757d;
    --shadow: rgba(9, 30, 62, 0.15);
    --event-upcoming: #1a2a44;
    --event-past: #6c757d;
}

.event-section {
    background: linear-gradient(rgba(249, 250, 251, 0.98), rgba(249, 250, 251, 0.98)), url('{{ asset('img/pattern-bg.png') }}');
    position: relative;
    overflow: hidden;
}

.section-title {
    max-width: 800px;
    margin: 0 auto 60px;
    text-align: center;
}

.section-title h2 {
    color: var(--primary-orange);
    font-size: 1.5rem;
    letter-spacing: 1px;
    font-weight: 700;
    margin-bottom: 10px;
}

.section-title h1 {
    color: var(--primary-navy);
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 15px;
}

.section-title .underline {
    width: 100px;
    height: 4px;
    background: linear-gradient(to right, var(--primary-orange), var(--secondary-orange));
    border-radius: 2px;
    margin: 0 auto;
}

.event-card {
    background: var(--white);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    margin-bottom: 25px;
}

.event-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px var(--shadow);
}

.event-image-container {
    position: relative;
    height: 200px;
    overflow: hidden;
}

.event-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
}

.event-card:hover .event-image {
    transform: scale(1.08);
}

.badge-container {
    position: absolute;
    top: 15px;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    padding: 0 15px;
    z-index: 2;
}

.event-type-badge {
    background: var(--primary-orange);
    color: var(--white);
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 20px;
    box-shadow: 0 4px 12px rgba(255, 122, 0, 0.3);
    font-size: 0.8rem;
}

.event-status-badge {
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 20px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    color: white;
    font-size: 0.8rem;
}

.card-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}

.event-title-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
}

.event-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--primary-navy);
    line-height: 1.3;
    margin: 0;
}

.detail-icon-circle {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: var(--light-orange);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--primary-orange);
    margin-left: 10px;
    flex-shrink: 0;
    transition: all 0.3s ease;
}

.detail-icon-circle:hover {
    background-color: var(--primary-orange);
    color: var(--white);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(255, 122, 0, 0.4);
}

.event-details {
    margin-bottom: 15px;
}

.detail-item {
    display: flex;
    align-items: center;
    margin-bottom: 12px;
}

.icon-circle {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: var(--light-orange);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--primary-orange);
    margin-right: 12px;
    flex-shrink: 0;
}

.detail-text .label {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 2px;
}

.detail-text .value {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-dark);
    margin: 0;
}

.action-container {
    margin-top: auto;
    padding-top: 15px;
}

.register-btn {
    background: var(--primary-navy);
    color: var(--white);
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 600;
    font-size: 1.1rem;
    box-shadow: 0 4px 8px rgba(9, 30, 62, 0.2);
    transition: all 0.3s ease;
    display: inline-block;
    width: 100%;
    text-align: center;
    text-decoration: none;
}

.register-btn:hover {
    background: #0a2752;
    box-shadow: 0 6px 12px rgba(9, 30, 62, 0.3);
    transform: translateY(-2px);
    color: var(--white);
}

.register-btn i {
    margin-right: 6px;
}

.empty-state {
    padding: 60px 0;
    text-align: center;
}

.empty-state i {
    color: var(--primary-orange);
    font-size: 4rem;
    margin-bottom: 20px;
}

.empty-state h4 {
    color: var(--primary-navy);
    font-size: 1.75rem;
    margin-bottom: 15px;
}

.empty-state p {
    color: var(--text-muted);
    font-size: 1.1rem;
}

.fade-in {
    opacity: 0;
    animation: fadeIn 1s ease forwards;
}

@keyframes fadeIn {
    to { opacity: 1; }
}

@media (max-width: 991px) {
    .section-title h1 {
        font-size: 2rem;
    }
    
    .event-title {
        font-size: 1.1rem;
    }
}

@media (max-width: 767px) {
    .section-title h1 {
        font-size: 1.75rem;
    }
    
    .event-image-container {
        height: 180px;
    }
    
    .icon-circle {
        width: 36px;
        height: 36px;
    }
}

@media (max-width: 575px) {
    .section-title h2 {
        font-size: 1.2rem;
    }
    
    .badge-container {
        top: 10px;
    }
    
    .event-type-badge,
    .event-status-badge {
        font-size: 0.7rem;
        padding: 4px 8px;
    }
    
    .register-btn {
        padding: 6px 12px;
        font-size: 0.85rem;
    }
}
</style>
{% endblock %}

{% block body %}


