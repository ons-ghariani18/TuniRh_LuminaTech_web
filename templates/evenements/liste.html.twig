<style>
    /* Style pour les liens de navigation */
    
    
    /* Style spécifique pour les éléments dropdown */
    .dropdown-item.hover-orange:hover {
        background-color: #ff8c00 !important;
        color: white !important;
    }
</style>

<div class="container-fluid py-5 event-section">
    <div class="container py-5">
        <nav aria-label="breadcrumb" class="mb-4">
            
        </nav>

        <div class="section-title">
            <h2 class="fw-bold">Tous nos événements</h2>
            <h1 class="mb-0 display-5 fw-bold">Découvrez nos prochains événements</h1>
            <div class="underline"></div>
        </div>

        <div class="row g-4">
            {% if evenements is defined and evenements|length > 0 %}
                {% for evenement in evenements %}
                    {% set is_past = evenement.dateDebut < date() %}
                    <div class="col-lg-4 col-md-6 mb-4 fade-in" style="animation-delay: {{ loop.index0 * 0.1 }}s">
                        <div class="card border-0 rounded-4 event-card">
                            <div class="event-image-container">
                                <img class="event-image"
                                     src="{{ evenement.image ? asset('Uploads/evenements/' ~ evenement.image) : asset('img/events/default.jpg') }}"
                                     alt="{{ evenement.nom }}">
                                
                                <div class="badge-container">
                                    <span class="event-type-badge">
                                        {% if evenement.type == 'Recrutement' %}
                                            <i class="fas fa-users me-1"></i>
                                        {% elseif evenement.type == 'Formation' %}
                                            <i class="fas fa-graduation-cap me-1"></i>
                                        {% elseif evenement.type == 'Conférence' %}
                                            <i class="fas fa-chalkboard-teacher me-1"></i>
                                        {% else %}
                                            <i class="fas fa-calendar-alt me-1"></i>
                                        {% endif %}
                                        {{ evenement.type }}
                                    </span>
                                    
                                    <span class="event-status-badge" style="background-color: {{ is_past ? 'var(--event-past)' : 'var(--event-upcoming)' }}">
                                        {% if is_past %}
                                            <i class="fas fa-history me-1"></i> Passé
                                        {% else %}
                                            <i class="fas fa-calendar-check me-1"></i> À venir
                                        {% endif %}
                                    </span>
                                </div>
                            </div>
                            
                            <div class="card-body">
                                <div class="event-title-container">
                                    <h3 class="event-title">{{ evenement.nom }}</h3>
                                    <a href="{{ path('app_evenement_public_detail', {'id': evenement.idEv}) }}" class="detail-icon-circle">
                                        <i class="fas fa-info-circle"></i>
                                    </a>
                                </div>
                                
                                <div class="event-details">
                                    <div class="detail-item">
                                        <div class="icon-circle">
                                            <i class="far fa-calendar-alt"></i>
                                        </div>
                                        <div class="detail-text">
                                            <div class="label">Date</div>
                                            <p class="value">{{ evenement.dateDebut|date('d M Y') }}</p>
                                        </div>
                                    </div>
                                    
                                    <div class="detail-item">
                                        <div class="icon-circle">
                                            <i class="far fa-clock"></i>
                                        </div>
                                        <div class="detail-text">
                                            <div class="label">Horaire</div>
                                            <p class="value">{{ evenement.dateDebut|date('H:i') }}</p>
                                        </div>
                                    </div>
                                    
                                    <div class="detail-item">
                                        <div class="icon-circle">
                                            <i class="fas fa-map-marker-alt"></i>
                                        </div>
                                        <div class="detail-text">
                                            <div class="label">Lieu</div>
                                            <p class="value">{{ evenement.lieu }}</p>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="action-container">
                                    <a href="{{ path('app_login') }}" class="register-btn">
                                        <i class="fas fa-user-plus"></i> S'inscrire
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <div class="col-12 empty-state">
                    <i class="far fa-calendar-times"></i>
                    <h4>Aucun événement disponible pour le moment</h4>
                    <p>Revenez bientôt pour découvrir nos prochains événements !</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}