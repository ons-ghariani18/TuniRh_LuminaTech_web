{% extends 'base.html.twig' %}

{% block title %}{{ offre.titre }}{% endblock %}

{% block body %}
    <!-- ======= Offre Details Section ======= -->
    <section id="offre-details" class="section-bg">
        <div class="container py-5">
            <!-- En-tête -->
            <div class="section-title text-center mb-5 wow fadeInDown" data-wow-delay="0.2s">
                <h2>{{ offre.titre }}</h2>
                <p>Découvrez les détails de cette opportunité et postulez dès maintenant !</p>
                <div class="title-underline"></div>
            </div>

            <!-- Carte -->
            <div class="card shadow-lg wow fadeInUp" data-wow-delay="0.1s">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="mb-0">{{ offre.titre }}</h3>
                    <span class="badge {{ offre.statut == 'Ouverte' ? 'badge-open' : 'badge-closed' }} p-2">
                        {{ offre.statut }}
                    </span>
                </div>
                
                <div class="card-body p-5">
                    <!-- Informations principales -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <p><i class="bi bi-briefcase me-2"></i> <strong>Type de contrat :</strong> {{ offre.typeContrat }}</p>
                            <p><i class="bi bi-geo-alt me-2"></i> <strong>Lieu :</strong> {{ offre.lieu }}</p>
                        </div>
                        <div class="col-md-6">
                            <p><i class="bi bi-calendar me-2"></i> <strong>Publié le :</strong> {{ offre.datePublication ? offre.datePublication|date('d/m/Y') : 'N/A' }}</p>
                            <p><i class="bi bi-tools me-2"></i> <strong>Compétences requises :</strong> {{ offre.competencesRequises|u.truncate(50, '...') }}</p>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="mb-5">
                        <h4 class="description-title"><i class="bi bi-file-text me-2"></i> Description du poste</h4>
                        <div class="prose p-4 rounded shadow-sm">
                            {{ offre.description|raw }}
                        </div>
                    </div>

                    <!-- Appel à l'action -->
                    <div class="text-center mt-5">
                        <a href="{{ path('app_candidatures_postuler', {'id_offre': offre.idOffre}) }}" 
                           class="btn btn-submit-orange btn-lg wow zoomIn" data-wow-delay="0.3s">
                            <i class="bi bi-paper-plane me-2"></i> Postuler maintenant
                        </a>
                        <a href="{{ path('app_offres_index') }}" 
                           class="btn btn-return-blue btn-lg wow zoomIn" data-wow-delay="0.4s">
                            <i class="bi bi-arrow-left me-2"></i> Retour
                        </a>
                    </div>
                </div>

                <div class="card-footer text-center">
                    <small>Offre publiée par Esprit - Opportunité vérifiée</small>
                </div>
            </div>
        </div>
    </section>
    <!-- End Offre Details Section -->
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        :root {
            --primary-blue: #1B263B;
            --primary-orange: #E76F51;
            --orange-light: #F28C38;
            --background-dark: #0B1322;
            --card-bg: #FFFFFF;
            --text-dark: #2D3142;
            --text-light: #F5F6F5;
            --text-muted: #6c757d;
            --shadow-sm: 0 4px 12px rgba(0, 0, 0, 0.15);
            --shadow-lg: 0 12px 30px rgba(0, 0, 0, 0.2);
            --transition: all 0.3s ease;
        }

        /* Section */
        .section-bg {
            background: linear-gradient(45deg, var(--background-dark), var(--primary-blue));
            padding: 80px 0;
            min-height: 100vh;
            position: relative;
            overflow: hidden;
        }

        /* En-tête */
        .section-title h2 {
            font-size: 2.8rem;
            font-weight: 800;
            color: var(--primary-orange);
            text-transform: uppercase;
            letter-spacing: 2px;
            text-shadow: 2px 2px 8px rgba(231, 111, 81, 0.3);
        }

        .section-title p {
            font-size: 1.2rem;
            color: var(--text-light);
            max-width: 600px;
            margin: 0 auto;
            opacity: 0.9;
        }

        .title-underline {
            width: 80px;
            height: 4px;
            background: linear-gradient(90deg, var(--primary-orange), var(--orange-light));
            border-radius: 2px;
            margin: 20px auto;
            transition: width 0.3s ease;
            box-shadow: 0 0 10px rgba(231, 111, 81, 0.5);
        }

        .section-title:hover .title-underline {
            width: 120px;
        }

        /* Carte */
        .card {
            background: var(--card-bg);
            border-radius: 15px;
            border: none;
            box-shadow: var(--shadow-lg);
            transition: transform 0.4s ease, box-shadow 0.4s ease;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.25);
        }

        .card-header {
            background: linear-gradient(135deg, var(--primary-blue), var(--primary-blue) 60%, var(--primary-orange));
            padding: 20px;
            border-radius: 15px 15px 0 0;
            position: relative;
            overflow: hidden;
        }

        .card-header h3 {
            font-size: 1.6rem;
            font-weight: 700;
            color: var(--text-light);
        }

        .card-body {
            padding: 2.5rem;
            background: #F9FAFB;
        }

        .card-footer {
            background: #F9FAFB;
            padding: 15px;
            border-radius: 0 0 15px 15px;
            color: var(--text-muted);
        }

        /* Badge */
        .badge {
            font-size: 0.9rem;
            padding: 6px 12px;
            border-radius: 20px;
            font-weight: 600;
        }

        .badge-open {
            background: #28a745;
            color: var(--text-light);
        }

        .badge-closed {
            background: #6c757d;
            color: var(--text-light);
        }

        /* Informations */
        .card-body p {
            font-size: 1rem;
            color: var(--text-dark);
            margin-bottom: 15px;
            display: flex;
            align-items: center;
        }

        .card-body i {
            color: var(--primary-orange);
            font-size: 1.2rem;
            margin-right: 8px;
            transition: transform 0.3s ease;
        }

        .card-body p:hover i {
            transform: scale(1.1);
            color: var(--orange-light);
        }

        .description-title {
            font-size: 1.3rem;
            font-weight: 600;
            color: var(--primary-blue);
            margin-bottom: 15px;
            display: flex;
            align-items: center;
        }

        .description-title i {
            color: var(--primary-orange);
        }

        .prose {
            line-height: 1.8;
            font-size: 1.1rem;
            color: var(--text-dark);
            background: var(--card-bg);
            border: 1px solid #E5E7EB;
            box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.05);
        }

        /* Boutons */
        .btn {
            padding: 12px 30px;
            font-size: 1.1rem;
            border-radius: 25px;
            text-decoration: none;
            transition: all 0.3s ease;
            font-weight: 600;
            position: relative;
            overflow: hidden;
        }

        .btn-submit-orange {
            background: var(--primary-orange);
            color: var(--text-light);
            box-shadow: var(--shadow-sm);
            margin-right: 15px;
        }

        .btn-submit-orange:hover {
            background: var(--orange-light);
            transform: translateY(-2px) scale(1.05);
            box-shadow: 0 6px 15px rgba(231, 111, 81, 0.5);
        }

        .btn-return-blue {
            background: transparent;
            color: var(--primary-blue);
            border: 2px solid var(--primary-blue);
            box-shadow: var(--shadow-sm);
        }

        .btn-return-blue:hover {
            background: var(--primary-blue);
            color: var(--text-light);
            border-color: transparent;
            transform: translateY(-2px) scale(1.05);
            box-shadow: 0 6px 15px rgba(27, 38, 59, 0.5);
        }

        .btn i {
            vertical-align: middle;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .section-title h2 {
                font-size: 2rem;
            }
            .section-title p {
                font-size: 1rem;
            }
            .card-body {
                padding: 1.5rem;
            }
            .btn {
                width: 100%;
                margin: 10px 0 !important;
            }
        }

        @media (max-width: 576px) {
            .section-title h2 {
                font-size: 1.8rem;
            }
            .title-underline {
                width: 60px;
            }
            .section-title:hover .title-underline {
                width: 90px;
            }
            .card-header h3 {
                font-size: 1.2rem;
            }
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Initialiser WOW.js pour les animations
        new WOW().init();

        // Animation de clic sur les boutons
        $(document).ready(function() {
            $('.btn-submit-orange, .btn-return-blue').on('click', function(e) {
                e.preventDefault();
                const href = $(this).attr('href');
                $(this).animate({ scale: 0.95 }, 100, function() {
                    $(this).animate({ scale: 1 }, 100, function() {
                        window.location.href = href;
                    });
                });
            });
        });
    </script>
{% endblock %}