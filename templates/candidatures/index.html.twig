{% block body %}
    <section class="careers-section">
        <div class="container">
            <!-- Titre principal -->
            <div class="section-header wow zoomIn" data-wow-delay="0.2s">
                <h1>Votre Carrière Commence Ici</h1>
                <p>Explorez des opportunités qui correspondent à vos ambitions.</p>
                <div class="title-underline"></div>
            </div>

            <!-- Barre de recherche et filtres -->
            <div class="search-filter-container wow fadeInUp" data-wow-delay="0.4s">
                <form method="get" action="{{ path('app_offres_index') }}">
                    <div class="search-bar">
                        <i class="bi bi-search"></i>
                        <input type="text" name="search" placeholder="Rechercher une offre..." value="{{ search ?? '' }}">
                    </div>
                    <div class="filter-group">
                        <select name="type_contrat" onchange="this.form.submit()">
                            <option value="">Type de contrat</option>
                            {% for type in types_contrat %}
                                <option value="{{ type }}" {{ selected_type_contrat == type ? 'selected' : '' }}>{{ type }}</option>
                            {% endfor %}
                        </select>
                        <select name="lieu" onchange="this.form.submit()">
                            <option value="">Lieu</option>
                            {% for lieu_option in lieux %}
                                <option value="{{ lieu_option }}" {{ selected_lieu == lieu_option ? 'selected' : '' }}>{{ lieu_option }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </form>
            </div>

            <!-- Messages Flash -->
            {% for message in app.flashes('success') %}
                <div class="alert wow fadeIn" data-wow-delay="0.2s">
                    <i class="bi bi-check-circle me-2"></i> {{ message }}
                </div>
            {% endfor %}

            <!-- Liste des offres -->
