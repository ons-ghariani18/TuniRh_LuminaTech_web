{% extends 'base.html.twig' %}

{% block title %}Gestion des Sponsors{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.materialdesignicons.com/5.4.55/css/materialdesignicons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-color: #e67e22;
            --primary-dark: #d35400;
            --secondary-color: #091E3E;
            --sidebar-bg: #091E3E;
            --sidebar-text: #a3adcc;
            --body-bg: #f5f7fa;
            --card-bg: #fff;
            --text-color: #333;
            --muted-text: #6b7280;
            --border-color: #e0e0e0;
            --transition-speed: 0.3s;
        }

        body {
            font-family: 'Nunito', sans-serif;
            background: var(--body-bg);
            color: var(--text-color);
            margin: 0;
            padding: 0;
            min-height: 100vh;
            overflow-x: hidden;
        }

        .flex {
            display: flex;
        }

        .flex-1 {
            flex: 1;
        }

        .h-screen {
            height: 100vh;
        }

        .items-center {
            align-items: center;
        }

        .justify-between {
            justify-content: space-between;
        }

        .gap-2 {
            gap: 0.5rem;
        }

        .gap-4 {
            gap: 1rem;
        }

        .text-xl {
            font-size: 1.25rem;
        }

        .text-2xl {
            font-size: 1.5rem;
        }

        .font-bold {
            font-weight: 700;
        }

        .rounded-full {
            border-radius: 9999px;
        }

        .mb-6 {
            margin-bottom: 1.5rem;
        }

        .mr-2 {
            margin-right: 0.5rem;
        }

        /* Sidebar & Main Content */
        .app-container {
            position: relative;
            display: flex;
            min-height: 100vh;
        }

        .aside {
            width: 240px;
            background-color: var(--sidebar-bg);
            color: var(--sidebar-text);
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            overflow-y: auto;
            padding-top: 60px;
            z-index: 100;
            transition: transform var(--transition-speed) ease, box-shadow var(--transition-speed) ease;
        }

        .aside.is-collapsed {
            transform: translateX(-240px);
            box-shadow: none;
        }

        body.sidebar-expanded .aside {
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
        }

        .aside .aside-brand {
            position: fixed;
            top: 0;
            height: 60px;
            background-color: var(--sidebar-bg);
            width: 240px;
            display: flex;
            align-items: center;
            padding: 0 1.5rem;
            font-size: 1.2rem;
            font-weight: bold;
            color: white;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            z-index: 101;
            transition: transform var(--transition-speed) ease;
        }

        .aside.is-collapsed .aside-brand {
            transform: translateX(-240px);
        }

        .menu-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            margin: 1rem 1.5rem 0.25rem;
            color: rgba(255, 255, 255, 0.4);
        }

        .menu-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 1.5rem;
            color: var(--sidebar-text);
            text-decoration: none;
            transition: background 0.3s, color 0.3s;
        }

        .menu-item:hover, .menu-item.is-active {
            background-color: var(--primary-color);
            color: white;
        }

        .main-content {
            margin-left: 240px;
            flex: 1;
            padding: 0;
            transition: margin-left var(--transition-speed) ease;
        }

        .main-content.sidebar-collapsed {
            margin-left: 0;
        }

        .content-inner {
            padding: 2rem;
        }

        /* Navbar */
        .navbar {
            position: sticky;
            top: 0;
            background: white;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 1px 4px rgba(0,0,0,0.05);
            z-index: 99;
        }

        .navbar-menu {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .search-input {
            padding: 0.5rem 1rem;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            width: 250px;
            font-family: 'Nunito', sans-serif;
        }

        .menu-toggle {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            border-radius: 6px;
            background-color: transparent;
            color: var(--text-color);
            border: 1px solid var(--border-color);
            cursor: pointer;
            transition: background 0.2s;
            margin-right: 1rem;
        }

        .menu-toggle:hover {
            background-color: var(--body-bg);
        }

        .menu-toggle i {
            transition: transform 0.3s;
        }

        .menu-toggle.active i {
            transform: rotate(180deg);
        }

        /* Button & Table */
        .btn-primary {
            background: var(--primary-color);
            color: white;
            padding: 0.5rem 1rem;
            border-radius: 6px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            transition: background 0.3s;
            text-decoration: none;
            border: none;
            cursor: pointer;
            font-family: 'Nunito', sans-serif;
        }

        .btn-primary:hover {
            background: var(--primary-dark);
        }

        .table-container {
            margin-top: 2rem;
            background: var(--card-bg);
            padding: 1.5rem;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            overflow-x: auto;
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
        }

        .data-table th, .data-table td {
            text-align: left;
            padding: 0.75rem 1rem;
            border-bottom: 1px solid var(--border-color);
        }

        .data-table th {
            background: #f9f9f9;
            font-weight: 700;
        }

        .data-table tr:last-child td {
            border-bottom: none;
        }

        .data-table tr:hover {
            background-color: #fef7f1;
        }

        .action-link {
            color: var(--primary-dark);
            margin-right: 0.5rem;
            text-decoration: none;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
        }

        .action-link:hover {
            text-decoration: underline;
        }

        .pdf-link {
            color: #e74c3c;
            margin-right: 0.5rem;
        }

        .pdf-link:hover {
            color: #c0392b;
        }

        .no-records {
            text-align: center;
            color: var(--muted-text);
            padding: 1rem;
        }

        /* Search form styles */
        .search-form {
            background: var(--card-bg);
            padding: 1.5rem;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            margin-bottom: 2rem;
        }

        .form-row {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .form-group {
            flex: 1;
            min-width: 200px;
        }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 600;
            color: var(--text-color);
        }

        .form-control {
            width: 100%;
            padding: 0.5rem 1rem;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            font-family: 'Nunito', sans-serif;
        }

        .form-actions {
            display: flex;
            justify-content: flex-end;
            gap: 1rem;
        }

        .btn-reset {
            background: #f0f0f0;
            color: var(--text-color);
            padding: 0.5rem 1rem;
            border-radius: 6px;
            border: 1px solid var(--border-color);
            cursor: pointer;
            font-family: 'Nunito', sans-serif;
        }

        .btn-reset:hover {
            background: #e0e0e0;
        }

        /* Overlay for mobile */
        .sidebar-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            z-index: 90;
            opacity: 0;
            visibility: hidden;
            transition: opacity var(--transition-speed), visibility var(--transition-speed);
        }

        .sidebar-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        /* PDF Icon Styles */
        .mdi-file-pdf-box {
            font-size: 1.5rem;
            transition: transform 0.2s;
        }

        .mdi-file-pdf-box:hover {
            transform: scale(1.1);
        }

        @media (max-width: 768px) {
            .aside {
                transform: translateX(-240px);
            }

            .aside.is-expanded {
                transform: translateX(0);
            }

            .main-content {
                margin-left: 0;
            }

            .navbar {
                padding: 1rem;
            }

            .search-input {
                width: 100%;
                max-width: 200px;
            }

            .data-table th a {
                color: var(--text-color);
                text-decoration: none;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .data-table th a:hover {
                color: var(--primary-color);
            }

            .sort-active {
                color: var(--primary-color) !important;
            }

            .sort-icon {
                margin-left: 0.5rem;
                transition: transform 0.2s;
            }

            .sort-desc .sort-icon {
                transform: rotate(180deg);
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="app-container">
    <aside class="aside" id="sidebar">
        <div class="aside-brand">
            <i class="mdi mdi-account-tie mr-2"></i> RH Dashboard
        </div>

        <div class="aside-menu">
            <p class="menu-label">GÉNÉRAL</p>
            <a href="{{ path('app_back_office') }}" class="menu-item">
                <i class="mdi mdi-view-dashboard"></i> Tableau de bord
            </a>

            <p class="menu-label">GESTION RH</p>
            <a href="#" class="menu-item">
                <i class="mdi mdi-account-group"></i> Profils Utilisateurs
            </a>
            <a href="#" class="menu-item">
                <i class="mdi mdi-briefcase"></i> Offres d'emploi
            </a>
            <a href="#" class="menu-item">
                <i class="mdi mdi-file-document"></i> Candidatures
            </a>
            <a href="#" class="menu-item">
                <i class="mdi mdi-message-alert"></i> Réclamations
            </a>

            <p class="menu-label">ÉVÉNEMENTS</p>
            <a href="{{ path('app_evenement_index') }}" class="menu-item">
                <i class="mdi mdi-calendar"></i> Événements
            </a>
            <a href="{{ path('app_sponsor_index') }}" class="menu-item is-active">
                <i class="mdi mdi-handshake"></i> Sponsors
            </a>

            <p class="menu-label">FORMATION</p>
            <a href="#" class="menu-item">
                <i class="mdi mdi-school"></i> Formations
            </a>
            <a href="#" class="menu-item">
                <i class="mdi mdi-account-voice"></i> Entretiens
            </a>
        </div>
    </aside>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="main-content" id="mainContent">
        <header class="navbar">
            <div class="flex items-center">
                <button id="menuToggle" class="menu-toggle" aria-label="Toggle Menu">
                    <i class="mdi mdi-menu"></i>
                </button>
                <input type="text" placeholder="Rechercher..." class="search-input">
            </div>
            <div class="navbar-menu">
                <i class="mdi mdi-bell-outline text-xl"></i>
                <div class="flex items-center gap-2">
                    <img src="https://ui-avatars.com/api/?name=RH+Admin&background=091E3E&color=fff" class="rounded-full" width="36" alt="Admin Avatar">
                    <span>Admin RH</span>
                </div>
            </div>
        </header>

        <div class="content-inner">
            <div class="flex justify-between items-center mb-6">
                <h1 class="text-2xl font-bold">Gestion des Sponsors</h1>
                <a href="{{ path('app_sponsor_new') }}" class="btn-primary">
                    <i class="mdi mdi-plus-circle"></i> Nouveau Sponsor
                </a>
            </div>

            {# Formulaire de recherche #}
            <div class="search-form">
                {{ form_start(searchForm, {'attr': {'class': 'search-form'}}) }}
                    <div class="form-row">
                        <div class="form-group">
                            {{ form_label(searchForm.nom) }}
                            {{ form_widget(searchForm.nom, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="form-group">
                            {{ form_label(searchForm.type) }}
                            {{ form_widget(searchForm.type, {'attr': {'class': 'form-control'}}) }}
                        </div>
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn-primary">
                            <i class="mdi mdi-magnify"></i> Rechercher
                        </button>
                    </div>
                {{ form_end(searchForm) }}
            </div>

            <div class="table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>
                                <a href="{{ path('app_sponsor_index', app.request.query.all|merge({'sort': 'id_sp', 'direction': (sortField == 'id_sp' and sortDirection == 'asc') ? 'desc' : 'asc'})) }}"
                                   class="{{ sortField == 'id_sp' ? 'sort-active' : '' }}">
                                    ID
                                    <i class="mdi mdi-arrow-{{ (sortField == 'id_sp' and sortDirection == 'desc') ? 'down' : 'up' }} sort-icon {{ sortField == 'id_sp' ? (sortDirection == 'desc' ? 'sort-desc' : 'sort-asc') : '' }}"></i>
                                </a>
                            </th>
                            <th>
                                <a href="{{ path('app_sponsor_index', app.request.query.all|merge({'sort': 'nom', 'direction': (sortField == 'nom' and sortDirection == 'asc') ? 'desc' : 'asc'})) }}"
                                   class="{{ sortField == 'nom' ? 'sort-active' : '' }}">
                                    Nom
                                    <i class="mdi mdi-arrow-{{ (sortField == 'nom' and sortDirection == 'desc') ? 'down' : 'up' }} sort-icon {{ sortField == 'nom' ? (sortDirection == 'desc' ? 'sort-desc' : 'sort-asc') : '' }}"></i>
                                </a>
                            </th>
                            <th>
                                <a href="{{ path('app_sponsor_index', app.request.query.all|merge({'sort': 'type', 'direction': (sortField == 'type' and sortDirection == 'asc') ? 'desc' : 'asc'})) }}"
                                   class="{{ sortField == 'type' ? 'sort-active' : '' }}">
                                    Type
                                    <i class="mdi mdi-arrow-{{ (sortField == 'type' and sortDirection == 'desc') ? 'down' : 'up' }} sort-icon {{ sortField == 'type' ? (sortDirection == 'desc' ? 'sort-desc' : 'sort-asc') : '' }}"></i>
                                </a>
                            </th>
                            <th>
                                <a href="{{ path('app_sponsor_index', app.request.query.all|merge({'sort': 'email', 'direction': (sortField == 'email' and sortDirection == 'asc') ? 'desc' : 'asc'})) }}"
                                   class="{{ sortField == 'email' ? 'sort-active' : '' }}">
                                    Email
                                    <i class="mdi mdi-arrow-{{ (sortField == 'email' and sortDirection == 'desc') ? 'down' : 'up' }} sort-icon {{ sortField == 'email' ? (sortDirection == 'desc' ? 'sort-desc' : 'sort-asc') : '' }}"></i>
                                </a>
                            </th>
                            <th>Téléphone</th>
                            <th>Contrat</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        {% for sponsor in sponsors %}
                            <tr>
                                <td>{{ sponsor.idSp }}</td>
                                <td>{{ sponsor.nom }}</td>
                                <td>{{ sponsor.type }}</td>
                                <td>{{ sponsor.email }}</td>
                                <td>{{ sponsor.telephone }}</td>
                                <td>
                                    <a href="{{ path('generate_pdf', {'id': sponsor.idSp}) }}" 
                                       class="pdf-link" 
                                       title="Générer le contrat PDF">
                                        <i class="mdi mdi-file-pdf-box"></i>
                                    </a>

                                    <a href="{{ path('app_sponsor_excel_export') }}" class="inline-block transition-transform duration-200 hover:scale-110" title="Exporter en Excel">
    <i class="mdi mdi-file-excel text-2xl text-green-600"></i>
</a>   
                                </td>
                                <td>
                                    <a href="{{ path('app_sponsor_show', {'id_sp': sponsor.idSp}) }}" class="action-link">
                                        <i class="mdi mdi-eye"></i> Voir
                                    </a>
                                    <a href="{{ path('app_sponsor_edit', {'id_sp': sponsor.idSp}) }}" class="action-link">
                                        <i class="mdi mdi-pencil"></i> Modifier
                                    </a>
                                    <a href="#" class="action-link delete-sponsor" data-sponsor-name="{{ sponsor.nom }}" data-delete-url="{{ path('app_sponsor_delete', {'id_sp': sponsor.idSp}) }}">
                                        <i class="mdi mdi-delete"></i> Supprimer
                                    </a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="no-records">Aucun sponsor trouvé</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Handle delete confirmation
            document.querySelectorAll('.delete-sponsor').forEach(link => {
                link.addEventListener('click', e => {
                    e.preventDefault();
                    const name = link.dataset.sponsorName;
                    const deleteUrl = link.dataset.deleteUrl;
                    
                    if (confirm(`Supprimer le sponsor "${name}" ? Cette action est irréversible.`)) {
                        window.location.href = deleteUrl;
                    }
                });
            });
            
            // Sidebar toggle with animation
            const sidebar = document.getElementById('sidebar');
            const mainContent = document.getElementById('mainContent');
            const menuToggle = document.getElementById('menuToggle');
            const sidebarOverlay = document.getElementById('sidebarOverlay');
            
            function toggleSidebar() {
                const isExpanded = !sidebar.classList.contains('is-collapsed');
                
                if (isExpanded) {
                    // Collapse sidebar
                    sidebar.classList.add('is-collapsed');
                    mainContent.classList.add('sidebar-collapsed');
                    menuToggle.classList.add('active');
                    document.body.classList.remove('sidebar-expanded');
                } else {
                    // Expand sidebar
                    sidebar.classList.remove('is-collapsed');
                    mainContent.classList.remove('sidebar-collapsed');
                    menuToggle.classList.remove('active');
                    document.body.classList.add('sidebar-expanded');
                }
                
                // Show overlay on mobile when sidebar is expanded
                if (window.innerWidth <= 768) {
                    if (!isExpanded) {
                        sidebarOverlay.classList.add('active');
                    } else {
                        sidebarOverlay.classList.remove('active');
                    }
                }
            }
            
            // Initialize sidebar state
            function initSidebar() {
                if (window.innerWidth <= 768) {
                    sidebar.classList.add('is-collapsed');
                    mainContent.classList.add('sidebar-collapsed');
                } else {
                    sidebar.classList.remove('is-collapsed');
                    mainContent.classList.remove('sidebar-collapsed');
                }
            }
            
            // Event listeners
            menuToggle.addEventListener('click', toggleSidebar);
            sidebarOverlay.addEventListener('click', () => {
                if (window.innerWidth <= 768) {
                    toggleSidebar();
                }
            });
            
            // Initialize on page load
            initSidebar();
            
            // Handle resize
            window.addEventListener('resize', () => {
                initSidebar();
                if (window.innerWidth > 768) {
                    sidebarOverlay.classList.remove('active');
                }
            });
        });
    </script>
{% endblock %}