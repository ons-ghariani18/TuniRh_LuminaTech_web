{% extends 'base.html.twig' %}

{% block title %}Détails du Sponsor{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.materialdesignicons.com/5.4.55/css/materialdesignicons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-color: #e67e22;
            --primary-dark: #d35400;
            --secondary-color: #091E3E;
            --sidebar-bg: #091E3E;
            --sidebar-text: #a3adcc;
            --body-bg: #f5f7fa;
            --card-bg: #fff;
            --text-color: #333;
            --muted-text: #6b7280;
            --border-color: #e0e0e0;
            --danger-color: #ef4444;
            --success-color: #10b981;
            --transition-speed: 0.3s;
        }

        body {
            font-family: 'Nunito', sans-serif;
            background: var(--body-bg);
            color: var(--text-color);
            margin: 0;
            padding: 0;
            min-height: 100vh;
        }

        /* Layout Structure */
        .app-container {
            display: flex;
            min-height: 100vh;
            position: relative;
        }

        /* Sidebar Styles */
        .aside {
            width: 240px;
            background-color: var(--sidebar-bg);
            color: var(--sidebar-text);
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            overflow-y: auto;
            z-index: 100;
            transition: transform var(--transition-speed) ease;
            transform: translateX(0);
        }

        .aside-collapsed {
            transform: translateX(-240px);
        }

        .aside-brand {
            height: 60px;
            background-color: var(--sidebar-bg);
            display: flex;
            align-items: center;
            padding: 0 1.5rem;
            font-size: 1.2rem;
            font-weight: bold;
            color: white;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            position: sticky;
            top: 0;
            z-index: 101;
        }

        .aside-menu {
            padding: 1rem 0;
        }

        .menu-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            margin: 1rem 1.5rem 0.25rem;
            color: rgba(255, 255, 255, 0.4);
        }

        .menu-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 1.5rem;
            color: var(--sidebar-text);
            text-decoration: none;
            transition: background 0.3s, color 0.3s;
        }

        .menu-item:hover, .menu-item.is-active {
            background-color: var(--primary-color);
            color: white;
        }

        /* Main Content */
        .main-content {
            margin-left: 240px;
            flex: 1;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            transition: margin-left var(--transition-speed) ease;
        }

        .main-content-full {
            margin-left: 0;
        }

        /* Navbar */
        .navbar {
            position: sticky;
            top: 0;
            background: white;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 1px 4px rgba(0,0,0,0.05);
            z-index: 99;
        }

        .menu-toggle {
            display: none;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            border-radius: 6px;
            background-color: transparent;
            color: var(--text-color);
            border: 1px solid var(--border-color);
            cursor: pointer;
            transition: background 0.2s;
            margin-right: 1rem;
        }

        .menu-toggle:hover {
            background-color: var(--body-bg);
        }

        /* Detail Styles */
        .detail-container {
            background: var(--card-bg);
            border-radius: 8px;
            padding: 2rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            max-width: 800px;
            margin: 2rem auto;
        }

        .detail-title {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
            color: var(--secondary-color);
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .detail-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 1.5rem;
        }

        .detail-table th, .detail-table td {
            padding: 1rem;
            border-bottom: 1px solid var(--border-color);
            text-align: left;
        }

        .detail-table th {
            width: 30%;
            color: var(--muted-text);
            font-weight: 600;
        }

        .detail-table td {
            font-weight: 500;
        }

        .detail-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            margin-top: 2rem;
            padding-top: 1.5rem;
            border-top: 1px solid var(--border-color);
        }

        .detail-actions .flex {
            display: flex;
            gap: 0.75rem;
        }

        .btn {
            padding: 0.75rem 1.25rem;
            border-radius: 6px;
            font-weight: 600;
            font-family: 'Nunito', sans-serif;
            cursor: pointer;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            text-decoration: none;
            border: none;
            font-size: 0.875rem;
            white-space: nowrap;
        }

        .btn i {
            font-size: 1.1em;
        }

        .btn-primary {
            background: var(--primary-color);
            color: white;
            box-shadow: 0 2px 4px rgba(230, 126, 34, 0.2);
        }

        .btn-primary:hover {
            background: var(--primary-dark);
            transform: translateY(-1px);
            box-shadow: 0 4px 6px rgba(230, 126, 34, 0.3);
        }

        .btn-secondary {
            background: white;
            color: var(--text-color);
            border: 1px solid var(--border-color);
        }

        .btn-secondary:hover {
            background: #f5f5f5;
            border-color: #d4d4d4;
            transform: translateY(-1px);
        }

        .btn-danger {
            background: var(--danger-color);
            color: white;
            box-shadow: 0 2px 4px rgba(239, 68, 68, 0.2);
        }

        .btn-danger:hover {
            background: #dc2626;
            transform: translateY(-1px);
            box-shadow: 0 4px 6px rgba(239, 68, 68, 0.3);
        }

        /* Effet au clic */
        .btn:active {
            transform: translateY(0);
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
        }

        /* Responsive */
        @media (max-width: 768px) {
            .aside {
                transform: translateX(-240px);
            }

            .aside.expanded {
                transform: translateX(0);
            }

            .main-content {
                margin-left: 0;
            }

            .menu-toggle {
                display: flex;
            }

            .navbar {
                padding: 1rem;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="app-container">
    {# Sidebar #}
    <aside class="aside" id="sidebar">
        <div class="aside-brand">
            <i class="mdi mdi-account-tie mr-2"></i> RH Dashboard
        </div>
        <div class="aside-menu">
            <p class="menu-label">GÉNÉRAL</p>
            <a href="{{ path('app_dashboard') }}" class="menu-item">
                <i class="mdi mdi-view-dashboard"></i> Tableau de bord
            </a>

            <p class="menu-label">GESTION RH</p>
            <a href="#" class="menu-item">
                <i class="mdi mdi-account-group"></i> Profils Utilisateurs
            </a>
            <a href="#" class="menu-item">
                <i class="mdi mdi-briefcase"></i> Offres d'emploi
            </a>
            <a href="#" class="menu-item">
                <i class="mdi mdi-file-document"></i> Candidatures
            </a>
            <a href="#" class="menu-item">
                <i class="mdi mdi-message-alert"></i> Réclamations
            </a>

            <p class="menu-label">ÉVÉNEMENTS</p>
            <a href="#" class="menu-item">
                <i class="mdi mdi-calendar"></i> Événements
            </a>
            <a href="{{ path('app_sponsor_index') }}" class="menu-item is-active">
                <i class="mdi mdi-handshake"></i> Sponsors
            </a>

            <p class="menu-label">FORMATION</p>
            <a href="#" class="menu-item">
                <i class="mdi mdi-school"></i> Formations
            </a>
            <a href="#" class="menu-item">
                <i class="mdi mdi-account-voice"></i> Entretiens
            </a>
        </div>
    </aside>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="main-content" id="mainContent">
        {# Navbar #}
        <header class="navbar">
            <div class="flex items-center">
                <button id="menuToggle" class="menu-toggle" aria-label="Toggle Menu">
                    <i class="mdi mdi-menu"></i>
                </button>
            </div>
            <div class="navbar-menu">
                <div class="flex items-center gap-2">
                    <img src="https://ui-avatars.com/api/?name=RH+Admin&background=091E3E&color=fff" class="rounded-full" width="36" alt="Admin Avatar">
                    <span>Admin RH</span>
                </div>
            </div>
        </header>

        {# Content #}
        <div class="content-wrapper">
            <div class="detail-container">
                <h1 class="detail-title">
                    <i class="mdi mdi-handshake"></i>
                    Détails du Sponsor: {{ sponsor.nom }}
                </h1>

                <table class="detail-table">
                    <tbody>
                        <tr>
                            <th>ID</th>
                            <td>{{ sponsor.idsp }}</td>
                        </tr>
                        <tr>
                            <th>Nom</th>
                            <td>{{ sponsor.nom }}</td>
                        </tr>
                        <tr>
                            <th>Type</th>
                            <td>{{ sponsor.type }}</td>
                        </tr>
                        <tr>
                            <th>Téléphone</th>
                            <td>{{ sponsor.telephone }}</td>
                        </tr>
                        <tr>
                            <th>Email</th>
                            <td>{{ sponsor.email }}</td>
                        </tr>
                    </tbody>
                </table>

                <div class="detail-actions">
                    <a href="{{ path('app_sponsor_index') }}" class="btn btn-secondary">
                        <i class="mdi mdi-arrow-left"></i> Retour à la liste
                    </a>
                    <div class="flex gap-2">
                        <a href="{{ path('app_sponsor_edit', {'id_sp': sponsor.idsp}) }}" class="btn btn-primary">
                            <i class="mdi mdi-pencil"></i> Modifier
                        </a>
                        {{ include('sponsor/_delete_form.html.twig') }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const sidebar = document.getElementById('sidebar');
            const menuToggle = document.getElementById('menuToggle');
            const sidebarOverlay = document.getElementById('sidebarOverlay');

            // Toggle sidebar
            menuToggle.addEventListener('click', () => {
                sidebar.classList.toggle('expanded');
                sidebarOverlay.classList.toggle('active');
                document.body.classList.toggle('no-scroll');
            });

            // Close sidebar when clicking overlay
            sidebarOverlay.addEventListener('click', () => {
                sidebar.classList.remove('expanded');
                sidebarOverlay.classList.remove('active');
                document.body.classList.remove('no-scroll');
            });

            // Handle window resize
            function handleResize() {
                if (window.innerWidth > 768) {
                    sidebar.classList.remove('expanded');
                    sidebarOverlay.classList.remove('active');
                    document.body.classList.remove('no-scroll');
                }
            }

            window.addEventListener('resize', handleResize);
            handleResize(); // Initialize
        });
    </script>
{% endblock %}
