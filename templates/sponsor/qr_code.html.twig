{# templates/sponsor/qr_code.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}QR Code pour {{ sponsor.name }}{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h2 class="h4 mb-0">QR Code pour {{ sponsor.name }}</h2>
                </div>
                <div class="card-body text-center">
                    <div class="mb-4">
                        <img src="{{ qrCode }}" alt="QR Code pour {{ sponsor.name }}" class="img-fluid" />
                    </div>
                    
                    <div class="mb-3">
                        <h5>Options utilisées</h5>
                        <ul class="list-group">
                            <li class="list-group-item">Taille: {{ options.size }}px</li>
                            <li class="list-group-item">Marge: {{ options.margin }}px</li>
                            <li class="list-group-item">Couleur principale: <span style="display: inline-block; width: 20px; height: 20px; background-color: {{ options.foregroundColor }}"></span> {{ options.foregroundColor }}</li>
                            <li class="list-group-item">Couleur d'arrière-plan: <span style="display: inline-block; width: 20px; height: 20px; background-color: {{ options.backgroundColor }}"></span> {{ options.backgroundColor }}</li>
                        </ul>
                    </div>
                    
                    <div class="d-flex justify-content-between">
                        <a href="{{ path('app_sponsor_qr_generate', {'id_sp': sponsor.idSp, 'format': 'image'}) }}" class="btn btn-success">
                            <i class="fa fa-download"></i> Télécharger
                        </a>
                        <a href="{{ path('app_sponsor_qr_customize') }}?sponsor={{ sponsor.idSp }}" class="btn btn-primary">
                            <i class="fa fa-edit"></i> Personnaliser
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}