{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f4f7fc;
            margin: 0;
            padding: 0;
        }

        /* Login Section */
        .login-section {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)),
                        url('../img/background-login.jpg') center/cover no-repeat fixed;
            padding: 20px;
        }

        /* Improved Login Container */
        .login-container {
            background: rgba(255, 255, 255, 0.96);
            padding: 2.5rem;
            border-radius: 16px;
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15);
            max-width: 480px;
            width: 100%;
            text-align: center;
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            position: relative;
            overflow: hidden;
            opacity: 0;
            transform: translateY(-20px);
            animation: fadeIn 0.8s ease-out forwards;
        }

        .login-container::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(
                to bottom right,
                rgba(255, 123, 0, 0.08) 0%,
                rgba(255, 123, 0, 0) 50%
            );
            transform: rotate(30deg);
            z-index: -1;
        }

        /* Animations */
        @keyframes fadeIn {
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-8px); }
        }

        /* Header */
        .login-container h1 {
            font-size: 2.2rem;
            margin-bottom: 2rem;
            color: #2d3748;
            font-weight: 700;
            position: relative;
            display: inline-block;
        }

        .login-container h1::after {
            content: '';
            position: absolute;
            bottom: -12px;
            left: 50%;
            transform: translateX(-50%);
            width: 60px;
            height: 4px;
            background: #ff7b00;
            border-radius: 4px;
        }

        /* Form Elements */
        .form-group {
            margin-bottom: 1.75rem;
            text-align: left;
        }

        .form-label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 500;
            color: #4a5568;
            font-size: 0.95rem;
        }

        .form-control {
            height: 52px;
            border-radius: 10px;
            border: 1px solid #e2e8f0;
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
            padding: 0.75rem 1.25rem;
            font-size: 1rem;
            background-color: #f8fafc;
            width: 100%;
        }

        .form-control:focus {
            border-color: #ff7b00;
            box-shadow: 0 0 0 3px rgba(255, 123, 0, 0.15);
            background-color: #fff;
        }

        /* Checkbox */
        .form-check {
            margin: 1.75rem 0;
            text-align: left;
            display: flex;
            align-items: center;
        }

        .form-check-input {
            width: 1.2em;
            height: 1.2em;
            margin-right: 0.75rem;
            border: 2px solid #cbd5e0;
            transition: all 0.2s ease;
        }

        .form-check-input:checked {
            background-color: #ff7b00;
            border-color: #ff7b00;
        }

        .form-check-input:focus {
            box-shadow: 0 0 0 3px rgba(255, 123, 0, 0.15);
        }

        .form-check-label {
            color: #4a5568;
            font-size: 0.95rem;
        }

        /* Button */
        .btn-login {
            background: linear-gradient(135deg, #ff7b00, #ff9500);
            border: none;
            color: white;
            font-weight: 600;
            padding: 0.85rem;
            border-radius: 10px;
            transition: all 0.3s ease;
            font-size: 1.05rem;
            letter-spacing: 0.5px;
            box-shadow: 0 4px 15px rgba(255, 123, 0, 0.3);
            width: 100%;
            margin-top: 0.5rem;
            position: relative;
            overflow: hidden;
        }

        .btn-login:hover {
            background: linear-gradient(135deg, #e66a00, #ff8500);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(255, 123, 0, 0.4);
        }

        .btn-login:active {
            transform: translateY(0);
        }

        .btn-login::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -60%;
            width: 200%;
            height: 200%;
            background: rgba(255, 255, 255, 0.2);
            transform: rotate(30deg);
            transition: all 0.3s ease;
        }

        .btn-login:hover::after {
            left: 100%;
        }

        /* Links */
        .auth-links {
            display: flex;
            justify-content: center;
            gap: 1rem;
            margin-top: 1.75rem;
            color: #718096;
            font-size: 0.95rem;
        }

        .auth-links a {
            color: #ff7b00;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.2s ease;
            position: relative;
            padding-bottom: 2px;
        }

        .auth-links a:hover {
            color: #e66a00;
        }

        .auth-links a::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0;
            height: 2px;
            background: #ff7b00;
            transition: width 0.3s ease;
        }

        .auth-links a:hover::after {
            width: 100%;
        }

        /* Alert */
        .alert-danger {
            background-color: #fff5f5;
            color: #e53e3e;
            border: 1px solid #fed7d7;
            border-radius: 8px;
            padding: 1rem;
            margin-bottom: 1.5rem;
            text-align: left;
        }

        /* Responsive Design */
        @media (max-width: 576px) {
            .login-container {
                padding: 1.75rem;
                border-radius: 12px;
            }
            
            .login-container h1 {
                font-size: 1.8rem;
                margin-bottom: 1.5rem;
            }
            
            .form-control {
                height: 48px;
                padding: 0.65rem 1rem;
            }
            
            .auth-links {
                flex-direction: column;
                gap: 0.5rem;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <!-- Top Bar -->
    <div class="container-fluid bg-dark px-5 d-none d-lg-block">
        <div class="row gx-0">
            <div class="col-lg-8 text-center text-lg-start mb-2 mb-lg-0">
                <div class="d-inline-flex align-items-center" style="height: 45px;">
                    <small class="me-3 text-light"><i class="fa fa-map-marker-alt me-2"></i>123 Street, New York, USA</small>
                    <small class="me-3 text-light"><i class="fa fa-phone-alt me-2"></i>+012 345 6789</small>
                    <small class="text-light"><i class="fa fa-envelope-open me-2"></i>info@example.com</small>
                </div>
            </div>
            <div class="col-lg-4 text-center text-lg-end">
                <div class="d-inline-flex align-items-center" style="height: 45px;">
                    <a class="btn btn-sm btn-outline-light btn-sm-square rounded-circle me-2" href=""><i class="fab fa-twitter fw-normal"></i></a>
                    <a class="btn btn-sm btn-outline-light btn-sm-square rounded-circle me-2" href=""><i class="fab fa-facebook-f fw-normal"></i></a>
                    <a class="btn btn-sm btn-outline-light btn-sm-square rounded-circle me-2" href=""><i class="fab fa-linkedin-in fw-normal"></i></a>
                    <a class="btn btn-sm btn-outline-light btn-sm-square rounded-circle me-2" href=""><i class="fab fa-instagram fw-normal"></i></a>
                    <a class="btn btn-sm btn-outline-light btn-sm-square rounded-circle" href=""><i class="fab fa-youtube fw-normal"></i></a>
                </div>
            </div>
        </div>
    </div>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark px-5 py-3 py-lg-0 bg-dark">
        <div class="container-fluid">
            <a href="{{ path('app_home') }}" class="navbar-brand p-0">
                <h1 class="m-0"><i class="fa fa-building me-2"></i>TuniRH Company</h1>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                <span class="fa fa-bars"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarCollapse">
                <div class="navbar-nav ms-auto py-0">
                    <a href="{{ path('app_home') }}" class="nav-item nav-link hover-orange">Home</a>
                    <a href="{{ path('app_about') }}" class="nav-item nav-link hover-orange">About</a>

                    <div class="nav-item dropdown">
                        <a href="#" class="nav-link dropdown-toggle hover-orange" data-bs-toggle="dropdown">Services</a>
                        <div class="dropdown-menu m-0 bg-dark">
                            <a href="{{ path('app_recrutement') }}" class="dropdown-item text-white hover-orange">Recrutement</a>
                            <a href="{{ path('app_formation') }}" class="dropdown-item text-white hover-orange">Formation</a>
                        </div>
                    </div>

                    <div class="nav-item dropdown">
                        <a href="#" class="nav-link dropdown-toggle hover-orange" data-bs-toggle="dropdown">Resources</a>
                        <div class="dropdown-menu m-0 bg-dark">
                            <a href="{{ path('app_team') }}" class="dropdown-item text-white hover-orange">Our Team</a>
                            <a href="{{ path('app_testimonials') }}" class="dropdown-item text-white hover-orange">Testimonials</a>
                            <a href="{{ path('app_evenement') }}" class="dropdown-item text-white hover-orange">Our Events</a>
                            <a href="{{ path('app_sponsor') }}" class="dropdown-item text-white hover-orange">Our Sponsors</a>
                        </div>
                    </div>

                    <a href="{{ path('app_contact') }}" class="nav-item nav-link hover-orange">Contact</a>
                </div>

                <div class="d-flex ms-3">
                    <button type="button" class="btn text-primary hover-orange-btn" data-bs-toggle="modal" data-bs-target="#searchModal">
                        <i class="fa fa-search"></i>
                    </button>

                    {% if app.user %}
                        <div class="dropdown ms-3">
                            <button class="btn btn-primary dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown">
                                <i class="fa fa-user me-1"></i> {{ app.user.username }}
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="#">Mon profil</a></li>
                                <li><a class="dropdown-item" href="{{ path('app_logout') }}">Déconnexion</a></li>
                            </ul>
                        </div>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="btn btn-outline-primary ms-3">Log in</a>
                        <a href="{{ path('app_register') }}" class="btn btn-signup ms-2">Sign up</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </nav>

    <!-- Login Section -->
    <section class="login-section">
        <div class="login-container">
            <h1 class="text-center">Connectez-vous</h1>

            {% if error %}
                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            {% if app.user %}
                <div class="mb-4 text-center">
                    Vous êtes connecté en tant que <strong>{{ app.user.username }}</strong>,
                    <a href="{{ path('app_logout') }}" class="text-danger">Déconnexion</a>
                </div>
            {% endif %}

            <form method="post">
                <div class="form-group">
                    <label for="inputUsername" class="form-label">Nom d'utilisateur</label>
                    <input type="text" value="{{ last_username }}" name="username" id="inputUsername"
                           class="form-control" autocomplete="username" required autofocus>
                </div>

                <div class="form-group">
                    <label for="inputPassword" class="form-label">Mot de passe</label>
                    <input type="password" name="password" id="inputPassword"
                           class="form-control" autocomplete="current-password" required>
                </div>

                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="rememberMe" name="_remember_me">
                    <label class="form-check-label" for="rememberMe">Se souvenir de moi</label>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button class="btn-login" type="submit">
                    Se connecter
                </button>
            </form>

            <div class="auth-links">
                <a href="{{ path('app_register') }}">Créer un compte</a>
                <a href="#">Mot de passe oublié ?</a>
            </div>
        </div>
    </section>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const loginContainer = document.querySelector('.login-container');
            loginContainer.style.opacity = '1';
            loginContainer.style.transform = 'translateY(0)';
            
            // Add floating animation to the container on hover
            loginContainer.addEventListener('mouseenter', function() {
                this.style.animation = 'float 3s ease-in-out infinite';
            });
            
            loginContainer.addEventListener('mouseleave', function() {
                this.style.animation = 'none';
            });
        });
    </script>
{% endblock %}