{% extends 'base.html.twig' %}

{% block title %}Log in{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f4f7fc;
            margin: 0;
            padding: 0;
        }

        .login-section {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)),
                        url('../img/background-login.jpg') center/cover no-repeat fixed;
            padding: 20px;
        }

        .login-container {
            background: rgba(255, 255, 255, 0.96);
            padding: 2.5rem;
            border-radius: 16px;
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15);
            max-width: 480px;
            width: 100%;
            text-align: center;
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            position: relative;
            overflow: hidden;
            opacity: 0;
            transform: translateY(-20px);
            animation: fadeIn 0.8s ease-out forwards;
        }

        @keyframes fadeIn {
            to { opacity: 1; transform: translateY(0); }
        }

        .login-container h1 {
            font-size: 2.2rem;
            margin-bottom: 2rem;
            color: #2d3748;
            font-weight: 700;
            position: relative;
            display: inline-block;
        }

        .login-container h1::after {
            content: '';
            position: absolute;
            bottom: -12px;
            left: 50%;
            transform: translateX(-50%);
            width: 60px;
            height: 4px;
            background: #ff7b00;
            border-radius: 4px;
        }

        .form-group {
            margin-bottom: 1.75rem;
            text-align: left;
        }

        .form-label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 500;
            color: #4a5568;
            font-size: 0.95rem;
        }

        .form-control {
            height: 52px;
            border-radius: 10px;
            border: 1px solid #e2e8f0;
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
            padding: 0.75rem 1.25rem;
            font-size: 1rem;
            background-color: #f8fafc;
            width: 100%;
        }

        .form-control:focus {
            border-color: #ff7b00;
            box-shadow: 0 0 0 3px rgba(255, 123, 0, 0.15);
            background-color: #fff;
        }

        .btn-login {
            background: linear-gradient(135deg, #ff7b00, #ff9500);
            border: none;
            color: white;
            font-weight: 600;
            padding: 0.85rem;
            border-radius: 10px;
            transition: all 0.3s ease;
            font-size: 1.05rem;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            box-shadow: 0 4px 15px rgba(255, 123, 0, 0.3);
            width: 100%;
            margin-top: 0.5rem;
        }

        .btn-login:hover {
            background: linear-gradient(135deg, #e66a00, #ff8500);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(255, 123, 0, 0.4);
        }

        .register-link {
            display: block;
            margin-top: 1.75rem;
            color: #718096;
            font-size: 0.95rem;
        }

        .register-link a {
            color: #ff7b00;
            font-weight: 500;
            text-decoration: none;
        }

        /* Error messages */
        .invalid-feedback {
            color: #e53e3e;
            font-size: 0.85rem;
            margin-top: 0.25rem;
            display: block;
        }

        .is-invalid {
            border-color: #e53e3e;
        }

        @media (max-width: 576px) {
            .login-container {
                padding: 1.75rem;
                border-radius: 12px;
            }
            
            .login-container h1 {
                font-size: 1.8rem;
                margin-bottom: 1.5rem;
            }
            
            .form-control {
                height: 48px;
                padding: 0.65rem 1rem;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <!-- Même en-tête que pour le sign up -->
    <div class="container-fluid bg-dark px-5 d-none d-lg-block">
        <div class="row gx-0">
            <div class="col-lg-8 text-center text-lg-start mb-2 mb-lg-0">
                <div class="d-inline-flex align-items-center" style="height: 45px;">
                    <small class="me-3 text-light"><i class="fa fa-map-marker-alt me-2"></i>123 Street, New York, USA</small>
                    <small class="me-3 text-light"><i class="fa fa-phone-alt me-2"></i>+012 345 6789</small>
                    <small class="text-light"><i class="fa fa-envelope-open me-2"></i>info@example.com</small>
                </div>
            </div>
            <div class="col-lg-4 text-center text-lg-end">
                <div class="d-inline-flex align-items-center" style="height: 45px;">
                    <a class="btn btn-sm btn-outline-light btn-sm-square rounded-circle me-2" href=""><i class="fab fa-twitter fw-normal"></i></a>
                    <a class="btn btn-sm btn-outline-light btn-sm-square rounded-circle me-2" href=""><i class="fab fa-facebook-f fw-normal"></i></a>
                    <a class="btn btn-sm btn-outline-light btn-sm-square rounded-circle me-2" href=""><i class="fab fa-linkedin-in fw-normal"></i></a>
                    <a class="btn btn-sm btn-outline-light btn-sm-square rounded-circle me-2" href=""><i class="fab fa-instagram fw-normal"></i></a>
                    <a class="btn btn-sm btn-outline-light btn-sm-square rounded-circle" href=""><i class="fab fa-youtube fw-normal"></i></a>
                </div>
            </div>
        </div>
    </div>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark px-5 py-3 py-lg-0 bg-dark">
        <div class="container-fluid">
            <a href="{{ path('app_home') }}" class="navbar-brand p-0">
                <h1 class="m-0"><i class="fa fa-building me-2"></i>TuniRH Company</h1>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                <span class="fa fa-bars"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarCollapse">
                <div class="navbar-nav ms-auto py-0">
                    <a href="{{ path('app_home') }}" class="nav-item nav-link hover-orange">Home</a>
                    <a href="{{ path('app_about') }}" class="nav-item nav-link hover-orange">About</a>

                    <div class="nav-item dropdown">
                        <a href="#" class="nav-link dropdown-toggle hover-orange" data-bs-toggle="dropdown">Services</a>
                        <div class="dropdown-menu m-0 bg-dark">
                            <a href="{{ path('app_recrutement') }}" class="dropdown-item text-white hover-orange">Recrutement</a>
                            <a href="{{ path('app_formation') }}" class="dropdown-item text-white hover-orange">Formation</a>
                        </div>
                    </div>

                    <div class="nav-item dropdown">
                        <a href="#" class="nav-link dropdown-toggle hover-orange" data-bs-toggle="dropdown">Resources</a>
                        <div class="dropdown-menu m-0 bg-dark">
                            <a href="{{ path('app_team') }}" class="dropdown-item text-white hover-orange">Our Team</a>
                            <a href="{{ path('app_testimonials') }}" class="dropdown-item text-white hover-orange">Testimonials</a>
                            <a href="{{ path('app_evenement_index') }}" class="dropdown-item text-white hover-orange">Our Events</a>
                            <a href="{{ path('app_sponsor_index') }}" class="dropdown-item text-white hover-orange">Our Sponsors</a>
                        </div>
                    </div>

                    <a href="{{ path('app_contact') }}" class="nav-item nav-link hover-orange">Contact</a>
                </div>

                <div class="d-flex ms-3">
                    <button type="button" class="btn text-primary hover-orange-btn" data-bs-toggle="modal" data-bs-target="#searchModal">
                        <i class="fa fa-search"></i>
                    </button>

                    {% if app.user %}
                        <div class="dropdown ms-3">
                            <button class="btn btn-primary dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown">
                                <i class="fa fa-user me-1"></i> {{ app.user.email }}
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="#">Mon profil</a></li>
                                <li><a class="dropdown-item" href="{{ path('app_logout') }}">Déconnexion</a></li>
                            </ul>
                        </div>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="btn btn-outline-primary ms-3">Log in</a>
                        <a href="{{ path('app_register') }}" class="btn btn-signup ms-2">Sign up</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </nav>

    <section class="login-section">
        <div class="login-container">
            <h1 class="text-center">Welcome Back</h1>

            <form method="post" class="login-form">
                {% if error %}
                    <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                <div class="form-group">
                    <label for="inputEmail" class="form-label">Email Address</label>
                    <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" autocomplete="email" required autofocus placeholder="your.email@example.com">
                </div>

                <div class="form-group">
                    <label for="inputPassword" class="form-label">Password</label>
                    <input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required placeholder="Enter your password">
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" name="_remember_me" id="rememberMe">
                    <label class="form-check-label" for="rememberMe">Remember me</label>
                </div>

                <button class="btn btn-login" type="submit">Sign In</button>
                
                <div class="register-link">
                    Don't have an account? <a href="{{ path('app_register') }}">Sign up here</a>
                </div>
                
                <div class="text-center mt-3">
                    <a href="" class="text-muted">Forgot password?</a>
                </div>
            </form>
        </div>
    </section>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const loginContainer = document.querySelector('.login-container');
            loginContainer.style.opacity = '1';
            loginContainer.style.transform = 'translateY(0)';
        });
    </script>
{% endblock %}