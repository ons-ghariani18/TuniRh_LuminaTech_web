{# templates/favoris/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Événements favoris{% endblock %}

{% block body %}
<div class="content-inner">
    <div class="page-header">
        <h1 class="page-title">
            <i class="mdi mdi-star"></i> Mes Événements Favoris
        </h1>
    </div>

    <div class="table-container">
        {% if favoris|length > 0 %}
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Type</th>
                        <th>Date Début</th>
                        <th>Date Fin</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for evenement in favoris %}
                    <tr>
                        <td>{{ evenement.nom }}</td>
                        <td>{{ evenement.type }}</td>
                        <td>{{ evenement.dateDebut|date('d/m/Y') }}</td>
                        <td>{{ evenement.dateFin|date('d/m/Y') }}</td>
                        <td>
                            <a href="{{ path('app_evenement_show', {'id_ev': evenement.idEv}) }}" class="action-link">
                                <i class="mdi mdi-eye"></i> Voir
                            </a>
                            <a href="#" class="toggle-favori action-link" 
                               data-id="{{ evenement.idEv }}"
                               title="Retirer des favoris">
                                <i class="mdi mdi-star text-yellow-500"></i>
                            </a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <div class="no-records">
                <i class="mdi mdi-star-off"></i> Aucun événement favori pour le moment
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}