{% extends 'base.html.twig' %}

{% block title %}Météo en Tunisie{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.materialdesignicons.com/5.4.55/css/materialdesignicons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-color: #e67e22;
            --primary-dark: #d35400;
            --secondary-color: #091E3E;
            --sidebar-bg: #091E3E;
            --sidebar-text: #a3adcc;
            --body-bg: #f5f7fa;
            --card-bg: #fff;
            --text-color: #333;
            --muted-text: #6b7280;
            --border-color: #e0e0e0;
            --transition-speed: 0.3s;
        }

        body {
            font-family: 'Nunito', sans-serif;
            background: var(--body-bg);
            color: var(--text-color);
            margin: 0;
            padding: 0;
            min-height: 100vh;
            overflow-x: hidden;
        }

        .flex {
            display: flex;
        }

        .flex-1 {
            flex: 1;
        }

        .flex-col {
            flex-direction: column;
        }

        .flex-row {
            flex-direction: row;
        }

        .h-screen {
            height: 100vh;
        }

        .items-center {
            align-items: center;
        }

        .justify-between {
            justify-content: space-between;
        }

        .gap-2 {
            gap: 0.5rem;
        }

        .gap-4 {
            gap: 1rem;
        }

        .gap-6 {
            gap: 1.5rem;
        }

        .text-xl {
            font-size: 1.25rem;
        }

        .text-2xl {
            font-size: 1.5rem;
        }

        .font-bold {
            font-weight: 700;
        }

        .font-semibold {
            font-weight: 600;
        }

        .rounded-full {
            border-radius: 9999px;
        }

        .rounded-lg {
            border-radius: 0.5rem;
        }

        .mb-6 {
            margin-bottom: 1.5rem;
        }

        .mr-2 {
            margin-right: 0.5rem;
        }

        .mt-6 {
            margin-top: 1.5rem;
        }

        .p-4 {
            padding: 1rem;
        }

        .p-6 {
            padding: 1.5rem;
        }

        .capitalize {
            text-transform: capitalize;
        }

        .text-gray-600 {
            color: var(--muted-text);
        }

        .text-gray-800 {
            color: var(--text-color);
        }

        .text-red-800 {
            color: #b91c1c;
        }

        .bg-white {
            background-color: var(--card-bg);
        }

        .bg-opacity-50 {
            background-opacity: 0.5;
        }

        .bg-red-100 {
            background-color: #fee2e2;
        }

        /* Notification badge */
        .notification-badge {
            position: relative;
            display: inline-block;
            margin-right: 1rem;
        }

        .notification-icon {
            font-size: 1.25rem;
            color: var(--text-color);
        }

        .badge-count {
            position: absolute;
            top: -0.5rem;
            right: -0.5rem;
            background-color: #ef4444;
            color: white;
            font-size: 0.75rem;
            border-radius: 9999px;
            height: 1.25rem;
            width: 1.25rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Sidebar & Main Content */
        .app-container {
            position: relative;
            display: flex;
            min-height: 100vh;
        }

        .aside {
            width: 240px;
            background-color: var(--sidebar-bg);
            color: var(--sidebar-text);
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            overflow-y: auto;
            padding-top: 60px;
            z-index: 100;
            transition: transform var(--transition-speed) ease, box-shadow var(--transition-speed) ease;
        }

        .aside.is-collapsed {
            transform: translateX(-240px);
            box-shadow: none;
        }

        body.sidebar-expanded .aside {
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
        }

        .aside .aside-brand {
            position: fixed;
            top: 0;
            height: 60px;
            background-color: var(--sidebar-bg);
            width: 240px;
            display: flex;
            align-items: center;
            padding: 0 1.5rem;
            font-size: 1.2rem;
            font-weight: bold;
            color: white;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            z-index: 101;
            transition: transform var(--transition-speed) ease;
        }

        .aside.is-collapsed .aside-brand {
            transform: translateX(-240px);
        }

        .menu-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            margin: 1rem 1.5rem 0.25rem;
            color: rgba(255, 255, 255, 0.4);
        }

        .menu-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 1.5rem;
            color: var(--sidebar-text);
            text-decoration: none;
            transition: background 0.3s, color 0.3s;
        }

        .menu-item:hover, .menu-item.is-active {
            background-color: var(--primary-color);
            color: white;
        }

        .main-content {
            margin-left: 240px;
            flex: 1;
            padding: 0;
            transition: margin-left var(--transition-speed) ease;
        }

        .main-content.sidebar-collapsed {
            margin-left: 0;
        }

        .content-inner {
            padding: 2rem;
        }

        /* Navbar */
        .navbar {
            position: sticky;
            top: 0;
            background: white;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 1px 4px rgba(0,0,0,0.05);
            z-index: 99;
        }

        .navbar-menu {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .search-input {
            padding: 0.5rem 1rem;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            width: 250px;
            font-family: 'Nunito', sans-serif;
        }

        .menu-toggle {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            border-radius: 6px;
            background-color: transparent;
            color: var(--text-color);
            border: 1px solid var(--border-color);
            cursor: pointer;
            transition: background 0.2s;
            margin-right: 1rem;
        }

        .menu-toggle:hover {
            background-color: var(--body-bg);
        }

        .menu-toggle i {
            transition: transform 0.3s;
        }

        .menu-toggle.active i {
            transform: rotate(180deg);
        }

        /* Button & weather card */
        .btn-primary {
            background: var(--primary-color);
            color: white;
            padding: 0.5rem 1rem;
            border-radius: 6px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            transition: background 0.3s;
            text-decoration: none;
            border: none;
            cursor: pointer;
            font-family: 'Nunito', sans-serif;
        }

        .btn-primary:hover {
            background: var(--primary-dark);
        }

        .btn-refresh {
            background-color: var(--primary-color);
            color: white;
            border: none;
            border-radius: 6px;
            padding: 0.5rem 1rem;
            cursor: pointer;
            transition: background 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
            font-weight: 600;
            font-family: 'Nunito', sans-serif;
        }

        .btn-refresh:hover {
            background-color: var(--primary-dark);
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
        }

        .page-title {
            font-size: 1.5rem;
            font-weight: 700;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .chart-container {
            margin-top: 1rem;
        }

        .weather-card {
            background: var(--card-bg);
            border-radius: 15px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease;
            margin-bottom: 2rem;
        }

        .weather-card:hover {
            transform: translateY(-5px);
        }

        .weather-icon {
            width: 80px;
            height: 80px;
        }

        .temperature {
            font-size: 2.5rem;
            font-weight: bold;
        }

        .region-selector {
            background-color: #fff;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            padding: 0.5rem 1rem;
            font-family: 'Nunito', sans-serif;
        }

        .form-container {
            background: var(--card-bg);
            padding: 1.5rem;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            margin-bottom: 2rem;
        }

        .grid {
            display: grid;
        }

        .grid-cols-2 {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .grid-cols-4 {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }

        @media (max-width: 768px) {
            .aside {
                transform: translateX(-240px);
            }

            .aside.is-expanded {
                transform: translateX(0);
            }

            .main-content {
                margin-left: 0;
            }

            .navbar {
                padding: 1rem;
            }

            .grid-cols-4 {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .flex-row {
                flex-direction: column;
            }
        }

        /* Overlay for mobile */
        .sidebar-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            z-index: 90;
            opacity: 0;
            visibility: hidden;
            transition: opacity var(--transition-speed), visibility var(--transition-speed);
        }

        .sidebar-overlay.active {
            opacity: 1;
            visibility: visible;
        }
    </style>
{% endblock %}

{% block body %}
<div class="app-container">
    <aside class="aside" id="sidebar">
        <div class="aside-brand">
            <i class="mdi mdi-account-tie mr-2"></i> RH Dashboard
        </div>

        <div class="aside-menu">
            <p class="menu-label">GÉNÉRAL</p>
            <a href="{{ path('app_back_office') }}" class="menu-item">
                <i class="mdi mdi-view-dashboard"></i> Tableau de bord
            </a>

            <p class="menu-label">GESTION RH</p>
            <a href="#" class="menu-item">
                <i class="mdi mdi-account-group"></i> Profils Utilisateurs
            </a>
            <a href="#" class="menu-item">
                <i class="mdi mdi-briefcase"></i> Offres d'emploi
            </a>
            <a href="#" class="menu-item">
                <i class="mdi mdi-file-document"></i> Candidatures
            </a>
            <a href="#" class="menu-item">
                <i class="mdi mdi-message-alert"></i> Réclamations
            </a>

            <p class="menu-label">ÉVÉNEMENTS</p>
            <a href="{{ path('app_evenement_index') }}" class="menu-item">
                <i class="mdi mdi-calendar"></i> Événements
            </a>
            <a href="{{ path('app_sponsor_index') }}" class="menu-item">
                <i class="mdi mdi-handshake"></i> Sponsors
            </a>
            <a href="{{ path('app_notification') }}" class="menu-item">
                <i class="mdi mdi-bell"></i> Notifications
            </a>

            <p class="menu-label">SERVICES</p>
            <a href="{{ path('app_weather') }}" class="menu-item is-active">
                <i class="mdi mdi-weather-cloudy"></i> Météo
            </a>

            <p class="menu-label">FORMATION</p>
            <a href="#" class="menu-item">
                <i class="mdi mdi-school"></i> Formations
            </a>
            <a href="#" class="menu-item">
                <i class="mdi mdi-account-voice"></i> Entretiens
            </a>
        </div>
    </aside>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="main-content" id="mainContent">
        <header class="navbar">
            <div class="flex items-center">
                <button id="menuToggle" class="menu-toggle" aria-label="Toggle Menu">
                    <i class="mdi mdi-menu"></i>
                </button>
            </div>
            <div class="navbar-menu">
                <a href="{{ path('app_notification') }}" class="notification-badge">
                    <i class="mdi mdi-bell-outline notification-icon"></i>
                    {% if upcoming_events is defined and upcoming_events|length > 0 %}
                        <span class="badge-count">{{ upcoming_events|length }}</span>
                    {% endif %}
                </a>
                <div class="flex items-center gap-2">
                    <img src="https://ui-avatars.com/api/?name=RH+Admin&background=091E3E&color=fff" class="rounded-full" width="36" alt="Admin Avatar">
                    <span>Admin RH</span>
                </div>
            </div>
        </header>

        <div class="content-inner">
            <div class="page-header">
                <h1 class="page-title">
                    <i class="mdi mdi-weather-cloudy mr-2"></i> Météo en Tunisie
                </h1>
            </div>

            <div class="form-container">
                <h2 class="text-xl font-bold mb-6"><i class="mdi mdi-map-marker-radius mr-2"></i> Sélectionner une région</h2>
                <form method="get" action="{{ path('app_weather') }}" class="flex items-center gap-4">
                    <select name="region" class="region-selector">
                        {% for key, region in regions %}
                            <option value="{{ key }}" {{ selectedRegion == key ? 'selected' : '' }}>{{ region }}</option>
                        {% endfor %}
                    </select>
                    
                    <button type="submit" class="btn-primary">
                        <i class="mdi mdi-magnify"></i> Afficher
                    </button>
                    
                    <a href="{{ path('app_weather', {'region': selectedRegion}) }}" class="btn-refresh">
                        <i class="mdi mdi-refresh"></i> Actualiser
                    </a>
                </form>
            </div>

            {% if error %}
                <div class="p-4 mb-6 bg-red-100 text-red-800 rounded-lg">
                    <i class="mdi mdi-alert-circle mr-2"></i> {{ error }}
                </div>
            {% endif %}

            {% if weather %}
            <div class="weather-card p-6">
                <div class="flex flex-col md:flex-row justify-between items-center gap-6 mb-6">
                    <div>
                        <h2 class="text-2xl font-bold text-gray-800">
                            <i class="mdi mdi-map-marker mr-2"></i> {{ weather.name }}, Tunisie
                        </h2>
                        <p class="text-gray-600">
                            <i class="mdi mdi-calendar-clock mr-2"></i> {{ "now"|date('d F Y H:i') }}
                        </p>
                    </div>
                    
                    <div class="flex items-center gap-4">
                        <div>
                            <img src="http://openweathermap.org/img/wn/{{ weather.weather[0].icon }}@2x.png" 
                                 alt="{{ weather.weather[0].description }}" 
                                 class="weather-icon">
                        </div>
                        <div class="temperature text-gray-800">
                            {{ weather.main.temp|round(1) }}°C
                        </div>
                    </div>
                </div>
                
                <div class="mt-6 grid grid-cols-2 md:grid-cols-4 gap-4">
                    <div class="bg-white bg-opacity-50 p-4 rounded-lg">
                        <div class="text-gray-600">
                            <i class="mdi mdi-weather-partly-cloudy mr-2"></i> Conditions
                        </div>
                        <div class="font-semibold capitalize">
                            {{ weather.weather[0].description }}
                        </div>
                    </div>
                    
                    <div class="bg-white bg-opacity-50 p-4 rounded-lg">
                        <div class="text-gray-600">
                            <i class="mdi mdi-thermometer mr-2"></i> Ressenti
                        </div>
                        <div class="font-semibold">
                            {{ weather.main.feels_like|round(1) }}°C
                        </div>
                    </div>
                    
                    <div class="bg-white bg-opacity-50 p-4 rounded-lg">
                        <div class="text-gray-600">
                            <i class="mdi mdi-water-percent mr-2"></i> Humidité
                        </div>
                        <div class="font-semibold">
                            {{ weather.main.humidity }}%
                        </div>
                    </div>
                    
                    <div class="bg-white bg-opacity-50 p-4 rounded-lg">
                        <div class="text-gray-600">
                            <i class="mdi mdi-weather-windy mr-2"></i> Vent
                        </div>
                        <div class="font-semibold">
                            {{ weather.wind.speed|round(1) }} m/s
                        </div>
                    </div>
                </div>
                
                <div class="mt-6 grid grid-cols-2 gap-4">
                    <div class="bg-white bg-opacity-50 p-4 rounded-lg">
                        <div class="text-gray-600">
                            <i class="mdi mdi-thermometer-low mr-2"></i> Température Min
                        </div>
                        <div class="font-semibold">
                            {{ weather.main.temp_min|round(1) }}°C
                        </div>
                    </div>
                    
                    <div class="bg-white bg-opacity-50 p-4 rounded-lg">
                        <div class="text-gray-600">
                            <i class="mdi mdi-thermometer-high mr-2"></i> Température Max
                        </div>
                        <div class="font-semibold">
                            {{ weather.main.temp_max|round(1) }}°C
                        </div>
                    </div>
                </div>
            </div>
            {% else %}
            <div class="weather-card p-6 flex flex-col items-center justify-center">
                <i class="mdi mdi-cloud-question text-gray-600" style="font-size: 80px;"></i>
                <p class="text-xl font-semibold text-gray-800 mt-6">Veuillez sélectionner une région pour afficher les informations météorologiques</p>
            </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Sidebar toggle with animation
            const sidebar = document.getElementById('sidebar');
            const mainContent = document.getElementById('mainContent');
            const menuToggle = document.getElementById('menuToggle');
            const sidebarOverlay = document.getElementById('sidebarOverlay');

            function toggleSidebar() {
                const isExpanded = !sidebar.classList.contains('is-collapsed');

                if (isExpanded) {
                    // Collapse sidebar
                    sidebar.classList.add('is-collapsed');
                    mainContent.classList.add('sidebar-collapsed');
                    menuToggle.classList.add('active');
                    document.body.classList.remove('sidebar-expanded');
                } else {
                    // Expand sidebar
                    sidebar.classList.remove('is-collapsed');
                    mainContent.classList.remove('sidebar-collapsed');
                    menuToggle.classList.remove('active');
                    document.body.classList.add('sidebar-expanded');
                }

                // Show overlay on mobile when sidebar is expanded
                if (window.innerWidth <= 768) {
                    if (!isExpanded) {
                        sidebarOverlay.classList.add('active');
                    } else {
                        sidebarOverlay.classList.remove('active');
                    }
                }
            }

            // Initialize sidebar state
            function initSidebar() {
                if (window.innerWidth <= 768) {
                    sidebar.classList.add('is-collapsed');
                    mainContent.classList.add('sidebar-collapsed');
                } else {
                    sidebar.classList.remove('is-collapsed');
                    mainContent.classList.remove('sidebar-collapsed');
                }
            }

            // Event listeners
            menuToggle.addEventListener('click', toggleSidebar);
            sidebarOverlay.addEventListener('click', () => {
                if (window.innerWidth <= 768) {
                    toggleSidebar();
                }
            });

            // Notification bell animation
            const notificationBell = document.querySelector('.notification-badge');
            if (notificationBell) {
                notificationBell.addEventListener('click', function() {
                    const icon = this.querySelector('i');
                    icon.classList.toggle('mdi-bell-outline');
                    icon.classList.toggle('mdi-bell');
                });
            }

            // Initialize on page load
            initSidebar();

            // Handle resize
            window.addEventListener('resize', () => {
                initSidebar();
                if (window.innerWidth > 768) {
                    sidebarOverlay.classList.remove('active');
                }
            });
        });
    </script>
{% endblock %}