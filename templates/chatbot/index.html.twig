{% extends 'base.html.twig' %}

{% block title %}Chatbot - Assistance Candidats{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        :root {
            --primary-blue: #1B263B;
            --primary-orange: #E76F51;
            --orange-light: #F28C38;
            --background-dark: #0B1322;
            --card-bg: #FFFFFF;
            --text-dark: #2D3142;
            --text-light: #F5F6F5;
            --shadow-sm: 0 4px 12px rgba(0, 0, 0, 0.15);
            --shadow-lg: 0 12px 30px rgba(0, 0, 0, 0.2);
            --transition: all 0.3s ease;
        }

        body {
            background: linear-gradient(45deg, var(--background-dark), var(--primary-blue));
            color: var(--text-light);
            margin: 0;
            padding: 0;
            min-height: 100vh;
            overflow-x: hidden;
            animation: gradientShift 10s ease infinite;
            font-family: 'Nunito', sans-serif;
        }

        @keyframes gradientShift {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* Conteneur principal */
        .chatbot-section {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 40px 20px;
        }

        .chatbot-container {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: var(--shadow-lg);
            width: 100%;
            max-width: 900px;
            padding: 30px;
            display: flex;
            flex-direction: column;
            gap: 30px;
        }

        /* En-tête */
        .chatbot-header {
            text-align: center;
            position: relative;
        }

        .chatbot-header h1 {
            font-size: 2.5rem;
            font-weight: 800;
            color: var(--primary-orange);
            text-transform: uppercase;
            letter-spacing: 2px;
            text-shadow: 2px 2px 8px rgba(231, 111, 81, 0.3);
            margin-bottom: 15px;
        }

        .chatbot-header p {
            font-size: 1.2rem;
            color: var(--text-light);
            opacity: 0.9;
            margin: 0;
        }

        .title-underline {
            width: 100px;
            height: 5px;
            background: linear-gradient(90deg, var(--primary-orange), var(--orange-light));
            border-radius: 5px;
            margin: 20px auto;
            transition: width var(--transition);
            box-shadow: 0 0 10px rgba(231, 111, 81, 0.5);
        }

        .chatbot-header:hover .title-underline {
            width: 150px;
        }

        .chatbot-icon {
            position: absolute;
            top: -60px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 3rem;
            color: var(--primary-orange);
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            padding: 15px;
            box-shadow: 0 0 15px rgba(231, 111, 81, 0.3);
        }

        /* Conteneur de messages */
        #chat-container {
            max-height: 400px;
            overflow-y: auto;
            padding: 20px;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 15px;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        #chat-container::-webkit-scrollbar {
            width: 8px;
        }

        #chat-container::-webkit-scrollbar-thumb {
            background: var(--primary-orange);
            border-radius: 10px;
        }

        #chat-container::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.1);
        }

        /* Messages */
        .message {
            margin: 10px 0;
            padding: 12px 20px;
            border-radius: 15px;
            font-size: 1rem;
            line-height: 1.4;
            position: relative;
            display: flex;
            align-items: flex-start;
            gap: 10px;
            max-width: 80%;
        }

        .message.user {
            background: var(--primary-orange);
            color: var(--text-light);
            margin-left: auto;
            margin-right: 10px;
            border-bottom-right-radius: 0;
        }

        .message.user::before {
            content: '';
            position: absolute;
            bottom: 0;
            right: -10px;
            width: 0;
            height: 0;
            border: 10px solid transparent;
            border-top-color: var(--primary-orange);
            border-right-color: var(--primary-orange);
        }

        .message.bot {
            background: var(--primary-blue);
            color: var(--text-light);
            margin-right: auto;
            margin-left: 10px;
            border-bottom-left-radius: 0;
        }

        .message.bot::before {
            content: '';
            position: absolute;
            bottom: 0;
            left: -10px;
            width: 0;
            height: 0;
            border: 10px solid transparent;
            border-top-color: var(--primary-blue);
            border-left-color: var(--primary-blue);
        }

        .message.error {
            background: rgba(231, 111, 81, 0.1);
            color: var(--primary-orange);
            border: 2px solid var(--primary-orange);
            margin: 10px auto;
            text-align: center;
            max-width: 90%;
        }

        .message .icon {
            font-size: 1.3rem;
            flex-shrink: 0;
        }

        /* Style pour les listes dans les messages du bot */
        .message.bot ul {
            margin: 5px 0 0 0;
            padding-left: 20px;
            list-style-type: disc;
        }

        .message.bot ul li {
            margin: 5px 0;
            font-size: 0.95rem;
            line-height: 1.3;
        }

        /* Formulaire */
        #chat-form {
            display: flex;
            gap: 15px;
            width: 100%;
            align-items: center;
        }

        #message {
            flex-grow: 1;
            padding: 12px 20px;
            border: none;
            border-radius: 50px;
            background: rgba(255, 255, 255, 0.1);
            color: var(--text-light);
            font-size: 1rem;
            transition: var(--transition);
            box-shadow: inset 0 0 5px rgba(0, 0, 0, 0.2);
        }

        #message:focus {
            background: rgba(255, 255, 255, 0.15);
            box-shadow: 0 0 15px rgba(231, 111, 81, 0.4);
            outline: none;
        }

        #chat-form button {
            background: var(--primary-orange);
            color: var(--text-light);
            border-radius: 50px;
            padding: 12px 25px;
            font-size: 1rem;
            font-weight: 600;
            transition: var(--transition);
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 4px 10px rgba(231, 111, 81, 0.3);
            position: relative;
            overflow: hidden;
        }

        #chat-form button::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
            transition: 0.5s;
        }

        #chat-form button:hover::before {
            left: 100%;
        }

        #chat-form button:hover {
            background: var(--orange-light);
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(231, 111, 81, 0.5);
        }

        /* Responsive */
        @media (max-width: 768px) {
            .chatbot-section {
                padding: 30px 15px;
            }

            .chatbot-container {
                padding: 20px;
            }

            .chatbot-header h1 {
                font-size: 2rem;
            }

            .chatbot-header p {
                font-size: 1rem;
            }

            .chatbot-icon {
                font-size: 2.5rem;
                top: -50px;
                padding: 10px;
            }

            #chat-container {
                max-height: 350px;
            }

            #chat-form {
                flex-direction: column;
                gap: 10px;
            }

            #message {
                width: 100%;
            }

            #chat-form button {
                width: 100%;
                max-width: 200px;
                justify-content: center;
            }

            .message {
                max-width: 85%;
            }
        }

        @media (max-width: 576px) {
            .chatbot-header h1 {
                font-size: 1.8rem;
            }

            .chatbot-header p {
                font-size: 0.9rem;
            }

            .chatbot-icon {
                font-size: 2rem;
                top: -40px;
                padding: 8px;
            }

            .message {
                font-size: 0.9rem;
                padding: 10px 15px;
            }

            .message .icon {
                font-size: 1.1rem;
            }

            .message.bot ul li {
                font-size: 0.9rem;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <section class="chatbot-section">
        <div class="chatbot-container wow fadeIn" data-wow-delay="0.2s">
            <!-- En-tête -->
            <div class="chatbot-header">
                <i class="bi bi-headset chatbot-icon"></i>
                <h1>Assistance Candidats TuniRh</h1>
                <p>Bienvenue ! Posez vos questions sur les offres d'emploi, les candidatures ou le processus de recrutement.</p>
                <div class="title-underline"></div>
            </div>

            <!-- Conteneur de messages -->
            <div id="chat-container" class="wow fadeInUp" data-wow-delay="0.4s">
                <div class="message bot wow fadeInLeft" data-wow-delay="0.1s">
                    <i class="bi bi-robot icon"></i>
                    <span>Bonjour ! Je suis l'assistant RH de TuniRh. Comment puis-je vous aider aujourd'hui ?</span>
                </div>
            </div>

            <!-- Formulaire -->
            <form id="chat-form" class="wow fadeInUp" data-wow-delay="0.6s">
                <input type="text" id="message" name="message" placeholder="Posez votre question ici...">
                <button type="submit">
                    <i class="bi bi-send"></i> Envoyer
                </button>
            </form>
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/wow/1.1.2/wow.min.js"></script>
    <script>
        // Initialiser WOW.js pour les animations
        if (typeof WOW !== 'undefined') {
            new WOW().init();
        } else {
            console.warn('WOW.js is not loaded, skipping initialization.');
        }

        const chatForm = document.getElementById('chat-form');
        const chatContainer = document.getElementById('chat-container');
        const messageInput = document.getElementById('message');

        chatForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const message = messageInput.value.trim();
            if (!message) {
                console.log('Message vide, envoi annulé');
                return;
            }

            console.log('Message envoyé:', message);

            // Afficher le message de l'utilisateur
            const userMessageDiv = document.createElement('div');
            userMessageDiv.className = 'message user';
            userMessageDiv.innerHTML = `
                <i class="bi bi-person-circle icon"></i>
                <span>${message}</span>
            `;
            chatContainer.appendChild(userMessageDiv);

            // Vider le champ de saisie
            messageInput.value = '';

            // Faire défiler vers le bas
            chatContainer.scrollTop = chatContainer.scrollHeight;

            try {
                console.log('Envoi de la requête fetch...');
                const response = await fetch('{{ path('chatbot_message') }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'Accept': 'application/json',
                    },
                    body: new URLSearchParams({
                        'message': message
                    })
                });

                console.log('Réponse fetch reçue:', response);

                if (!response.ok) {
                    throw new Error(`Erreur HTTP : ${response.status}`);
                }

                const data = await response.json();
                console.log('Données JSON:', data);

                if (data.error) {
                    console.log('Erreur dans la réponse:', data.error);
                    const errorMessageDiv = document.createElement('div');
                    errorMessageDiv.className = 'message error';
                    errorMessageDiv.innerHTML = `
                        <i class="bi bi-exclamation-circle icon"></i>
                        <span>${data.error}</span>
                    `;
                    chatContainer.appendChild(errorMessageDiv);
                } else {
                    // Remplacer les sauts de ligne par des <br>
                    let responseText = data.response.replace(/\n/g, '<br>');
                    console.log('Texte de la réponse formaté:', responseText);

                    // Créer la réponse du bot
                    const botMessageDiv = document.createElement('div');
                    botMessageDiv.className = 'message bot';
                    botMessageDiv.innerHTML = `
                        <i class="bi bi-robot icon"></i>
                        <span>${responseText}</span>
                    `;
                    chatContainer.appendChild(botMessageDiv);
                }

                // Faire défiler vers le bas
                chatContainer.scrollTop = chatContainer.scrollHeight;
            } catch (error) {
                console.error('Erreur lors de la requête fetch:', error);
                const errorMessageDiv = document.createElement('div');
                errorMessageDiv.className = 'message error';
                errorMessageDiv.innerHTML = `
                    <i class="bi bi-exclamation-circle icon"></i>
                    <span>Impossible de contacter le serveur. (${error.message})</span>
                `;
                chatContainer.appendChild(errorMessageDiv);
                chatContainer.scrollTop = chatContainer.scrollHeight;
            }
        });

        // Permettre l'envoi avec la touche Entrée
        messageInput.addEventListener('keypress', function (e) {
            if (e.key === 'Enter') {
                chatForm.dispatchEvent(new Event('submit'));
            }
        });
    </script>
{% endblock %}