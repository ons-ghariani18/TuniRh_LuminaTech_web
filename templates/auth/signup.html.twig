{% block stylesheets %}
    {{ parent() }}
    <style>
        :root {
            --primary-blue: #1B263B;
            --primary-orange: #E76F51;
            --orange-light: #F28C38;
            --background-dark: #0B1322;
            --card-bg: #FFFFFF;
            --text-dark: #2D3142;
            --text-light: #F5F6F5;
            --text-muted: #6c757d;
            --shadow-sm: 0 4px 12px rgba(0, 0, 0, 0.15);
            --shadow-lg: 0 12px 30px rgba(0, 0, 0, 0.2);
            --transition: all 0.3s ease;
            --border-color: #E5E7EB;
            --danger-color: #dc3545;
            --success-color: #28a745;
        }

        body {
            font-family: 'Nunito', sans-serif;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        .auth-section {
            background: linear-gradient(45deg, var(--background-dark), var(--primary-blue));
            min-height: 100vh;
            display: flex;
            align-items: center;
        }

        .section-header h1 {
            font-size: 2.5rem;
            font-weight: 800;
            color: var(--primary-orange);
            margin-bottom: 40px;
        }

        .form-container {
            background: var(--card-bg);
            border-radius: 15px;
            box-shadow: var(--shadow-lg);
            padding: 40px;
            border: 1px solid rgba(231, 111, 81, 0.2);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .form-container:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.25);
        }

        .form-group {
            position: relative;
        }

        .form-label {
            position: absolute;
            top: 0.75rem;
            left: 2.5rem;
            font-size: 1rem;
            color: var(--text-muted);
            transition: all 0.2s ease;
            pointer-events: none;
        }

        .form-control:not(:placeholder-shown) + .form-label,
        .form-control:focus + .form-label,
        .form-select:not(:placeholder-shown) + .form-label,
        .form-select:focus + .form-label {
            top: -0.5rem;
            left: 1.5rem;
            font-size: 0.75rem;
            color: var(--primary-orange);
            background: var(--card-bg);
            padding: 0 0.25rem;
        }

        .form-control, .form-select {
            width: 100%;
            padding: 0.75rem 1rem 0.75rem 2.5rem;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            font-family: 'Nunito', sans-serif;
            font-size: 1rem;
            background: #F9FAFB;
            transition: border-color 0.3s ease, box-shadow 0.3s ease;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--primary-orange);
            box-shadow: 0 0 8px rgba(231, 111, 81, 0.3);
            outline: none;
        }

        .form-group.is-invalid .form-control,
        .form-group.is-invalid .form-select {
            border-color: var(--danger-color);
            background: #fff5f5;
        }

        .invalid-feedback {
            color: var(--danger-color);
            font-size: 0.875rem;
            margin-top: 0.25rem;
            display: none;
        }

        .form-group.is-invalid .invalid-feedback {
            display: block;
        }

        .form-group i {
            position: absolute;
            top: 50%;
            left: 0.75rem;
            transform: translateY(-50%);
            color: var(--primary-orange);
            font-size: 1.1rem;
            transition: transform 0.3s ease;
        }

        .form-group:hover i {
            transform: translateY(-50%) scale(1.1);
            color: var(--orange-light);
        }

        .btn-orange {
            background: var(--primary-orange);
            color: var(--text-light);
            padding: 0.75rem;
            border-radius: 8px;
            font-weight: 600;
            border: none;
            transition: all 0.3s ease;
            box-shadow: var(--shadow-sm);
        }

        .btn-orange:hover {
            background: var(--orange-light);
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(231, 111, 81, 0.5);
        }

        .link {
            color: var(--primary-orange);
            text-align: center;
            display: block;
            margin-top: 20px;
            transition: color 0.3s ease;
            text-decoration: none;
        }

        .link:hover {
            color: var(--orange-light);
        }

        .alert {
            padding: 1rem;
            border-radius: 8px;
            margin-bottom: 1.5rem;
            font-size: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            box-shadow: var(--shadow-sm);
            animation: slideIn 0.3s ease;
        }

        .alert-success {
            background: #e6f4e6;
            color: var(--success-color);
            border: 1px solid var(--success-color);
        }

        .alert-error {
            background: #f8d7da;
            color: var(--danger-color);
            border: 1px solid var(--danger-color);
        }

        .alert i {
            font-size: 1.2rem;
        }

        @keyframes slideIn {
            from {
                transform: translateY(-20px);
                opacity: 0;
            }
            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        @media (max-width: 768px) {
            .section-header h1 {
                font-size: 2rem;
            }
            .form-container {
                padding: 20px;
            }
        }
    </style>
{% endblock %}

{% block javascripts %}
