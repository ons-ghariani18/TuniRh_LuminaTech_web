    <script>
        // Initialiser WOW.js pour les animations
        if (typeof WOW !== 'undefined') {
            new WOW().init();
        }

        document.addEventListener('DOMContentLoaded', () => {
            // Animation de clic sur le bouton d'inscription
            const signupButton = document.querySelector('.btn-orange');
            signupButton.addEventListener('click', function(e) {
                this.style.transition = 'transform 0.2s ease';
                this.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    this.style.transform = 'scale(1)';
                }, 100);
            });

            // Validation du formulaire
            const form = document.querySelector('.form-signup');
            if (form) {
                form.addEventListener('submit', (e) => {
                    let isValid = true;

                    // Vérifier les champs requis
                    const inputs = form.querySelectorAll('.form-control[required], .form-select[required]');
                    inputs.forEach(input => {
                        if (!input.value.trim()) {
                            isValid = false;
                            input.classList.add('is-invalid');
                            const feedback = input.nextElementSibling;
                            if (feedback && feedback.classList.contains('invalid-feedback')) {
                                feedback.textContent = 'Ce champ est requis.';
                            }
                        } else {
                            input.classList.remove('is-invalid');
                        }
                    });

                    // Valider l'email
                    const emailInput = form.querySelector('input[type="email"]');
                    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                    if (emailInput.value && !emailRegex.test(emailInput.value)) {
                        isValid = false;
                        emailInput.classList.add('is-invalid');
                        const feedback = emailInput.nextElementSibling;
                        if (feedback && feedback.classList.contains('invalid-feedback')) {
                            feedback.textContent = 'Veuillez fournir une adresse email valide.';
                        }
                    }

                    // Valider le téléphone
                    const telInput = form.querySelector('input[name$="[tel]"]');
