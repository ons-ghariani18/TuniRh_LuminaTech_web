{% extends 'base.html.twig' %}

{% block title %}Connexion - TuniRh{% endblock %}

{% block css %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdn.materialdesignicons.com/5.4.55/css/materialdesignicons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
{% endblock %}

{% block body %}
    <section class="login-section">
        <div class="container">
            <div class="row justify-content-center align-items-center min-vh-100">
                <div class="col-md-6 col-lg-4">
                    <div class="card shadow-lg border-0 wow fadeInUp" data-wow-delay="0.3s">
                        <div class="card-body p-5">
                            <h2 class="text-center mb-4" style="color: var(--primary-orange); font-weight: 700;">Connexion à TuniRh</h2>

                            {% if error %}
                                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    {{ error.messageKey|trans(error.messageData, 'security') }}
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            {% endif %}

                            <form method="post" action="{{ path('app_login') }}" class="form-login">
                                {{ form_start(form) }}
                                    <div class="mb-4 form-group position-relative">
                                        <i class="mdi mdi-email position-absolute" style="top: 50%; left: 0.75rem; transform: translateY(-50%); color: var(--primary-orange); font-size: 1.1rem; transition: transform 0.3s ease;"></i>
                                        {{ form_widget(form.email, {
                                            'attr': {
                                                'class': 'form-control',
                                                'placeholder': ' ',
                                                'autofocus': true
                                            }
                                        }) }}
                                        {{ form_label(form.email, 'Email', {'label_attr': {'class': 'form-label'}}) }}
                                        <div class="invalid-feedback">{{ form_errors(form.email) }}</div>
                                    </div>
                                    <div class="mb-4 form-group position-relative">
                                        <i class="mdi mdi-lock position-absolute" style="top: 50%; left: 0.75rem; transform: translateY(-50%); color: var(--primary-orange); font-size: 1.1rem; transition: transform 0.3s ease;"></i>
                                        {{ form_widget(form.password, {
                                            'attr': {
                                                'class': 'form-control',
                                                'placeholder': ' '
                                            }
                                        }) }}
                                        {{ form_label(form.password, 'Mot de passe', {'label_attr': {'class': 'form-label'}}) }}
                                        <div class="invalid-feedback">{{ form_errors(form.password) }}</div>
                                    </div>
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                                    <div class="d-grid mb-4">
                                        <button type="submit" class="btn btn-primary btn-lg wow zoomIn" data-wow-delay="0.4s">
                                            <i class="mdi mdi-login me-2"></i>Se connecter
                                        </button>
                                    </div>
                                {{ form_end(form) }}

                                <p class="text-center mt-3">
                                    Pas de compte ? <a href="{{ path('app_signup') }}" class="text-orange fw-bold">Inscrivez-vous</a>
                                    <br>
                                    <a href="{{ path('app_forgot_password') }}" class="text-orange fw-bold">Mot de passe oublié ?</a>
                                </p>
                            
                                
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <style>
        :root {
            --primary-blue: #1B263B;
            --primary-orange: #E76F51;
            --orange-light: #F28C38;
            --background-dark: #0B1322;
            --card-bg: #FFFFFF;
            --text-dark: #2D3142;
            --text-light: #F5F6F5;
            --text-muted: #6c757d;
            --shadow-sm: 0 4px 12px rgba(0, 0, 0, 0.15);
            --shadow-lg: 0 12px 30px rgba(0, 0, 0, 0.2);
            --transition: all 0.3s ease;
            --border-color: #E5E7EB;
            --danger-color: #dc3545;
        }

        body {
            font-family: 'Nunito', sans-serif;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        .login-section {
            background: linear-gradient(45deg, var(--background-dark), var(--primary-blue));
            min-height: 100vh;
            display: flex;
            align-items: center;
        }

        .card {
            background: var(--card-bg);
            border-radius: 15px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border: 1px solid rgba(231, 111, 81, 0.2);
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.25) !important;
        }

        .form-group {
            position: relative;
        }

        .form-label {
            position: absolute;
            top: 0.75rem;
            left: 2.5rem;
            font-size: 1rem;
            color: var(--text-muted);
            transition: all 0.2s ease;
            pointer-events: none;
        }

        .form-control:not(:placeholder-shown) + .form-label,
        .form-control:focus + .form-label {
            top: -0.5rem;
            left: 1.5rem;
            font-size: 0.75rem;
            color: var(--primary-orange);
            background: var(--card-bg);
            padding: 0 0.25rem;
        }

        .form-control {
            width: 100%;
            padding: 0.75rem 1rem 0.75rem 2.5rem;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            font-family: 'Nunito', sans-serif;
            font-size: 1rem;
            background: #F9FAFB;
            transition: border-color 0.3s ease, box-shadow 0.3s ease;
        }

        .form-control:focus {
            border-color: var(--primary-orange);
            box-shadow: 0 0 8px rgba(231, 111, 81, 0.3);
            outline: none;
        }

        .form-control.is-invalid {
            border-color: var(--danger-color);
        }

        .invalid-feedback {
            color: var(--danger-color);
            font-size: 0.875rem;
            margin-top: 0.25rem;
        }

        .form-group:hover i {
            transform: translateY(-50%) scale(1.1);
            color: var(--orange-light);
        }

        .btn-primary {
            background: var(--primary-orange);
            color: var(--text-light);
            border-radius: 8px;
            padding: 0.75rem;
            font-weight: 600;
            border: none;
            transition: all 0.3s ease;
            box-shadow: var(--shadow-sm);
        }

        .btn-primary:hover {
            background: var(--orange-light);
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(231, 111, 81, 0.5);
        }

        .text-orange {
            color: var(--primary-orange) !important;
            transition: color 0.3s ease;
        }

        .text-orange:hover {
            color: var(--orange-light) !important;
        }

        .alert {
            border-radius: 8px;
            font-size: 0.9rem;
        }

        .alert-danger {
            background: rgba(220, 53, 69, 0.1);
            border-color: var(--danger-color);
            color: var(--danger-color);
        }
    </style>
{% endblock %}

{% block js %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Initialiser WOW.js pour les animations
        new WOW().init();

        document.addEventListener('DOMContentLoaded', () => {
            // Animation de clic sur le bouton de connexion
            const loginButton = document.querySelector('.btn-primary');
            loginButton.addEventListener('click', function(e) {
                this.style.transition = 'transform 0.2s ease';
                this.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    this.style.transform = 'scale(1)';
                }, 100);
            });

            // Form validation
            const form = document.querySelector('form');
            if (form) {
                form.addEventListener('submit', (e) => {
                    let isValid = true;
                    const inputs = form.querySelectorAll('.form-control[required]');
                    inputs.forEach(input => {
                        if (!input.value.trim()) {
                            isValid = false;
                            input.classList.add('is-invalid');
                            const feedback = input.nextElementSibling;
                            if (feedback && feedback.classList.contains('invalid-feedback')) {
                                feedback.textContent = 'Ce champ est requis.';
                            }
                        } else {
                            input.classList.remove('is-invalid');
                        }
                    });

                    if (!isValid) {
                        e.preventDefault();
                        alert('Veuillez remplir tous les champs requis.');
                    }
                });

                // Real-time validation
                const inputs = form.querySelectorAll('.form-control');
                inputs.forEach(input => {
                    input.addEventListener('input', () => {
                        if (input.value.trim()) {
                            input.classList.remove('is-invalid');
                        }
                    });
                });
            }
        });
    </script>
{% endblock %}