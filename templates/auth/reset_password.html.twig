{% extends 'base.html.twig' %}

{% block title %}Réinitialisation du mot de passe - TuniRh{% endblock %}

{% block body %}
    <section class="login-section">
        <div class="container">
            <div class="row justify-content-center align-items-center min-vh-100">
                <div class="col-md-6 col-lg-4">
                    <div class="card shadow-lg border-0 wow fadeInUp" data-wow-delay="0.3s">
                        <div class="card-body p-5">
                            <h2 class="text-center mb-4" style="color: var(--primary-orange); font-weight: 700;">Nouveau mot de passe</h2>

                            {% for flash_success in app.flashes('success') %}
                                <div class="alert alert-success">{{ flash_success }}</div>
                            {% endfor %}
                            {% for flash_error in app.flashes('error') %}
                                <div class="alert alert-danger">{{ flash_error }}</div>
                            {% endfor %}

                            {{ form_start(form) }}
                                <div class="mb-4 form-group position-relative">
                                    <i class="mdi mdi-lock position-absolute" style="top: 50%; left: 0.75rem; transform: translateY(-50%); color: var(--primary-orange); font-size: 1.1rem;"></i>
                                    {{ form_widget(form.password.first) }}
                                    {{ form_label(form.password.first, 'Nouveau mot de passe', {'label_attr': {'class': 'form-label'}}) }}
                                    <div class="invalid-feedback">{{ form_errors(form.password.first) }}</div>
                                </div>
                                <div class="mb-4 form-group position-relative">
                                    <i class="mdi mdi-lock position-absolute" style="top: 50%; left: 0.75rem; transform: translateY(-50%); color: var(--primary-orange); font-size: 1.1rem;"></i>
                                    {{ form_widget(form.password.second) }}
                                    {{ form_label(form.password.second, 'Confirmer le mot de passe', {'label_attr': {'class': 'form-label'}}) }}
                                    <div class="invalid-feedback">{{ form_errors(form.password.second) }}</div>
                                </div>
                                <div class="d-grid mb-4">
                                    <button type="submit" class="btn btn-primary btn-lg wow zoomIn" data-wow-delay="0.4s">
                                        <i class="mdi mdi-check me-2"></i>Enregistrer
                                    </button>
                                </div>
                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}