{% extends 'base.html.twig' %}

{% block title %}Modifier une Réclamation{% endblock %}

{% block css %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root {
            --primary-orange: #F57C00;
            --primary-blue: #041E42;
            --background-light: #F5F5F5;
            --text-dark: #333333;
            --text-muted: #6c757d;
            --white-color: #ffffff;
            --shadow-sm: 0 4px 15px rgba(0, 0, 0, 0.1);
            --shadow-lg: 0 10px 30px rgba(0, 0, 0, 0.15);
            --danger-red: #dc3545;
        }

        .edit-reclamation-section {
            background: linear-gradient(160deg, var(--primary-blue) 0%, #1e293b 100%);
            padding: 80px 0;
            min-height: 100vh;
            color: var(--white-color);
            position: relative;
            overflow: hidden;
        }

        .section-header {
            margin-bottom: 40px;
            text-align: center;
        }
        .section-header h1 {
            font-size: 2.5rem;
            font-weight: 800;
            color: var(--primary-orange);
            text-transform: uppercase;
            letter-spacing: 1px;
            text-shadow: 2px 2px 10px rgba(245, 124, 0, 0.3);
        }
        .title-underline {
            width: 80px;
            height: 4px;
            background: var(--primary-orange);
            border-radius: 2px;
            margin: 15px auto;
            transition: width 0.3s ease;
        }
        .section-header:hover .title-underline {
            width: 120px;
        }

        .form-container {
            background: var(--white-color);
            border-radius: 20px;
            box-shadow: var(--shadow-lg);
            padding: 40px;
            max-width: 700px;
            margin: 0 auto;
        }
        .form-container label {
            color: var(--primary-blue);
            font-weight: 600;
            margin-bottom: 5px;
            display: block;
        }
        .form-container input,
        .form-container select,
        .form-container textarea {
            width: 100%;
            padding: 12px;
            margin-bottom: 20px;
            border: 2px solid var(--primary-blue);
            border-radius: 10px;
            font-size: 1rem;
            transition: border-color 0.3s ease, box-shadow 0.3s ease;
        }
        .form-container input:focus,
        .form-container select:focus,
        .form-container textarea:focus {
            border-color: var(--primary-orange);
            box-shadow: 0 0 8px rgba(245, 124, 0, 0.3);
            outline: none;
        }

        .btn {
            padding: 12px 25px;
            font-size: 1rem;
            border-radius: 25px;
            text-decoration: none;
            transition: all 0.4s ease;
            font-weight: 600;
            display: inline-block;
            text-align: center;
        }
        .btn-orange {
            background: var(--primary-orange);
            color: var(--white-color);
            box-shadow: var(--shadow-sm);
            border: none;
            width: 100%;
        }
        .btn-orange:hover {
            background: #e06b00;
            transform: translateY(-2px) scale(1.05);
            box-shadow: 0 6px 15px rgba(245, 124, 0, 0.4);
            color: var(--white-color);
        }
        .btn-danger {
            background: var(--danger-red);
            color: var(--white-color);
            box-shadow: var(--shadow-sm);
            border: none;
            width: 100%;
            margin-top: 10px;
        }
        .btn-danger:hover {
            background: #c82333;
            transform: translateY(-2px) scale(1.05);
            box-shadow: 0 6px 15px rgba(220, 53, 69, 0.4);
            color: var(--white-color);
        }

        .back-link {
            display: block;
            text-align: center;
            margin-top: 20px;
            color: var(--primary-orange);
            font-weight: 500;
            transition: color 0.3s ease;
        }
        .back-link:hover {
            color: #e06b00;
            text-decoration: underline;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .section-header h1 { font-size: 2rem; }
            .form-container { padding: 20px; }
            .btn { font-size: 0.9rem; }
        }
    </style>
{% endblock %}

{% block body %}
    <section class="edit-reclamation-section">
        <div class="container" data-aos="fade-up">
            <div class="section-header">
                <h1>Modifier une Réclamation</h1>
                <div class="title-underline"></div>
            </div>

            <div class="form-container" data-aos="fade-up" data-aos-delay="100">
                {{ include('reclamation/_form.html.twig', {'button_label': 'Mettre à jour'}) }}

                <a href="{{ path('app_reclamation_index') }}" class="back-link">
                    <i class="bi bi-arrow-left-circle"></i> Retour à la liste
                </a>

                {{ include('reclamation/_delete_form.html.twig') }}
            </div>
        </div>
    </section>
{% endblock %}

{% block js %}
    {{ parent() }}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
    <script>
        AOS.init({
            duration: 800,
            once: true
        });
    </script>
{% endblock %}