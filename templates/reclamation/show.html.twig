{% extends 'base.html.twig' %}

{% block title %}Détails de la Réclamation{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://cdn.materialdesignicons.com/5.4.55/css/materialdesignicons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('css/bootstrap.min.css') }}">

    <style>
        :root {
            --primary-blue: #1B263B;
            --primary-orange: #E76F51;
            --orange-light: #F28C38;
            --background-dark: #0B1322;
            --card-bg: #FFFFFF;
            --text-dark: #2D3142;
            --text-light: #F5F6F5;
            --text-muted: #6c757d;
            --shadow-sm: 0 4px 12px rgba(0, 0, 0, 0.15);
            --shadow-lg: 0 12px 30px rgba(0, 0, 0, 0.2);
            --transition: all 0.3s ease;
            --border-color: #E5E7EB;
            --success-green: #28a745;
            --warning-yellow: #ffc107;
            --danger-red: #dc3545;
            --navbar-primary: #e67e22 !important;
            --navbar-primary-hover: #d35400 !important;
            --navbar-dark: #091E3E !important;
        }

        body {
            font-family: 'Nunito', sans-serif;
            background: linear-gradient(45deg, var(--background-dark), var(--primary-blue));
            color: var(--text-dark);
            margin: 0;
            padding: 0;
            min-height: 100vh;
        }

        .flex { display: flex; }
        .items-center { align-items: center; }
        .justify-between { justify-content: space-between; }
        .gap-2 { gap: 0.5rem; }
        .gap-4 { gap: 1rem; }
        .text-xl { font-size: 1.25rem; }
        .text-2xl { font-size: 1.5rem; }
        .font-bold { font-weight: 700; }
        .mb-6 { margin-bottom: 1.5rem; }

        /* Navbar Styles */
        .navbar-dark .navbar-nav .nav-link {
            color: #fff !important;
            transition: color 0.3s ease;
        }

        .navbar-dark .navbar-nav .nav-link:hover,
        .navbar-dark .navbar-nav .nav-link.active {
            color: var(--navbar-primary) !important;
        }

        .navbar-dark .navbar-toggler {
            color: var(--navbar-primary) !important;
            border-color: var(--navbar-primary) !important;
        }

        .dropdown-menu.bg-dark {
            background-color: var(--navbar-dark) !important;
            border: none;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }

        .dropdown-item.text-white {
            color: #fff !important;
            transition: all 0.3s ease;
        }

        .dropdown-item.hover-orange:hover {
            background-color: #ff8c00 !important;
            color: white !important;
        }

        .btn-outline-primary {
            color: var(--navbar-primary) !important;
            border-color: var(--navbar-primary) !important;
            background-color: transparent !important;
            transition: all 0.3s ease;
        }

        .btn-outline-primary:hover {
            background-color: var(--navbar-primary) !important;
            color: #fff !important;
        }

        .btn-primary.navbar-btn {
            background-color: var(--navbar-primary) !important;
            border-color: var(--navbar-primary) !important;
            color: #fff !important;
            transition: all 0.3s ease;
        }

        .btn-primary.navbar-btn:hover {
            background-color: var(--navbar-primary-hover) !important;
            border-color: var(--navbar-primary-hover) !important;
        }

        .hover-orange {
            transition: color 0.3s ease;
        }

        .hover-orange:hover {
            color: var(--navbar-primary) !important;
        }

        .hover-orange-btn {
            transition: color 0.3s ease;
        }

        .hover-orange-btn:hover {
            color: var(--navbar-primary-hover) !important;
        }

        .dropdown-toggle::after {
            margin-left: 0.5rem;
        }

        .dropdown-menu-end {
            right: 0;
            left: auto;
        }

        /* Show Reclamation Section */
        .show-reclamation-section {
            padding: 2rem;
            min-height: 100vh;
        }

        .section-header {
            text-align: center;
            margin-bottom: 2rem;
        }

        .section-header h1 {
            font-size: 2rem;
            font-weight: 700;
            color: var(--primary-orange);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .title-underline {
            width: 60px;
            height: 4px;
            background: var(--primary-orange);
            border-radius: 2px;
            margin: 10px auto;
            transition: width 0.3s ease;
        }

        .section-header:hover .title-underline {
            width: 100px;
        }

        .reclamation-card {
            background: var(--card-bg);
            border-radius: 10px;
            box-shadow: var(--shadow-sm);
            padding: 2rem;
            max-width: 800px;
            margin: 0 auto;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .reclamation-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-lg);
        }

        .reclamation-card h2 {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--primary-blue);
            margin-bottom: 1rem;
        }

        .detail-item {
            display: flex;
            align-items: flex-start;
            margin-bottom: 1rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--border-color);
        }

        .detail-item i {
            color: var(--primary-orange);
            font-size: 1.2rem;
            margin-right: 1rem;
            margin-top: 0.2rem;
        }

        .detail-item div {
            flex: 1;
        }

        .detail-item strong {
            color: var(--primary-blue);
            font-weight: 600;
            display: block;
            margin-bottom: 0.2rem;
        }

        .detail-item span, .detail-item p {
            color: var(--text-muted);
            font-size: 0.95rem;
        }

        .status-badge {
            padding: 0.5rem 1rem;
            border-radius: 9999px;
            font-size: 0.875rem;
            font-weight: 600;
            display: inline-block;
        }

        .status-ouvert {
            background: var(--warning-yellow);
            color: #000;
        }

        .status-encours {
            background: var(--primary-orange);
            color: var(--text-light);
        }

        .status-ferme {
            background: var(--success-green);
            color: var(--text-light);
        }

        .action-buttons {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
            justify-content: center;
            margin-top: 2rem;
        }

        .btn {
            padding: 0.5rem 1.5rem;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            cursor: pointer;
        }

        .btn-orange {
            background: var(--primary-orange);
            color: var(--text-light);
            box-shadow: var(--shadow-sm);
            border: none;
        }

        .btn-orange:hover {
            background: var(--orange-light);
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(231, 111, 81, 0.5);
        }

        .btn-danger {
            background: var(--danger-red);
            color: var(--text-light);
            box-shadow: var(--shadow-sm);
            border: none;
        }

        .btn-danger:hover {
            background: #c82333;
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(220, 53, 69, 0.4);
        }

        .btn-back {
            color: var(--primary-orange);
            font-weight: 500;
        }

        .btn-back:hover {
            color: var(--orange-light);
            text-decoration: underline;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .show-reclamation-section {
                padding: 1rem;
            }

            .section-header h1 {
                font-size: 1.5rem;
            }

            .reclamation-card {
                padding: 1.5rem;
            }

            .detail-item {
                flex-direction: column;
                align-items: flex-start;
            }

            .detail-item i {
                margin-bottom: 0.5rem;
            }

            .btn {
                width: 100%;
                justify-content: center;
            }
        }

        @media (max-width: 991px) {
            .navbar-nav {
                padding-top: 1rem;
            }

            .d-flex.ms-3 {
                margin-top: 1rem;
                justify-content: center;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark px-5 py-3 py-lg-0 bg-dark">
        <div class="container-fluid">
            <a href="{{ path('app_home') }}" class="navbar-brand p-0">
                <h1 class="m-0"><i class="fa fa-building me-2"></i>TuniRH</h1>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                <span class="fa fa-bars"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarCollapse">
                <div class="navbar-nav ms-auto py-0">
                    <a href="{{ path('app_home') }}" class="nav-item nav-link hover-orange">Home</a>
                    <a href="{{ path('app_about') }}" class="nav-item nav-link hover-orange">About</a>
                    <div class="nav-item dropdown">
                        <a href="#" class="nav-link dropdown-toggle hover-orange" data-bs-toggle="dropdown">Services</a>
                        <div class="dropdown-menu m-0 bg-dark">
                            <a href="{{ path('app_offres_index') }}" class="dropdown-item text-white hover-orange">Recrutement</a>
                            <a href="{{ path('app_formation') }}" class="dropdown-item text-white hover-orange">Formation</a>
                            <a href="{{ path('app_reclamation_index') }}" class="dropdown-item text-white hover-orange">Réclamation</a>
                        </div>
                    </div>
                    <div class="nav-item dropdown">
                        <a href="#" class="nav-link dropdown-toggle hover-orange" data-bs-toggle="dropdown">Resources</a>
                        <div class="dropdown-menu m-0 bg-dark">
                            <a href="{{ path('app_team') }}" class="dropdown-item text-white hover-orange">Our Team</a>
                            <a href="{{ path('app_testimonials') }}" class="dropdown-item text-white hover-orange">Testimonials</a>
                            <a href="{{ path('app_evenement_index') }}" class="dropdown-item text-white hover-orange">Our Events</a>
                            <a href="{{ path('app_sponsor_index') }}" class="dropdown-item text-white hover-orange">Our Sponsors</a>
                        </div>
                    </div>
                    <a href="{{ path('app_contact') }}" class="nav-item nav-link hover-orange">Contact</a>
                </div>
                <div class="d-flex ms-3">
                    <button type="button" class="btn text-primary hover-orange-btn" data-bs-toggle="modal" data-bs-target="#searchModal">
                        <i class="fa fa-search"></i>
                    </button>
                    {% if app.user %}
                        <div class="dropdown ms-3">
                            <button class="btn btn-primary navbar-btn dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown">
                                <i class="fa fa-user me-1"></i> {{ app.user.email }}
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="#">Mon profil</a></li>
                                <li><a class="dropdown-item" href="{{ path('app_logout') }}">Déconnexion</a></li>
                            </ul>
                        </div>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="btn btn-outline-primary ms-3">Log in</a>
                        <a href="{{ path('app_register') }}" class="btn btn-primary navbar-btn ms-2">Sign up</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </nav>

    <!-- Search Modal -->
    <div class="modal fade" id="searchModal" tabindex="-1">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content" style="background: rgba(9, 30, 62, .7);">
                <div class="modal-header border-0">
                    <button type="button" class="btn bg-white btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body d-flex align-items-center justify-content-center">
                    <div class="input-group" style="max-width: 600px;">
                        <input type="text" class="form-control bg-transparent border-primary p-3" placeholder="Type search keyword">
                        <button class="btn btn-primary navbar-btn px-4"><i class="bi bi-search"></i></button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Reclamation Details -->
    <section class="show-reclamation-section">
        <div class="container" data-aos="fade-up">
            <div class="section-header">
                <h1>Détails de la Réclamation</h1>
                <div class="title-underline"></div>
            </div>

            <div class="reclamation-card" data-aos="fade-up" data-aos-delay="100">
                <h2>{{ reclamation.sujet }}</h2>
                <div class="detail-item">
                    <i class="mdi mdi-text"></i>
                    <div>
                        <strong>Description</strong>
                        <p>{{ reclamation.description }}</p>
                    </div>
                </div>
                <div class="detail-item">
                    <i class="mdi mdi-calendar"></i>
                    <div>
                        <strong>Date de Réclamation</strong>
                        <span>{{ reclamation.dateReclamation ? reclamation.dateReclamation|date('d/m/Y') : 'Non définie' }}</span>
                    </div>
                </div>
                <div class="detail-item">
                    <i class="mdi mdi-information"></i>
                    <div>
                        <strong>Statut</strong>
                        <span class="status-badge status-{{ reclamation.statut|lower }}">{{ reclamation.statut }}</span>
                    </div>
                </div>

                <div class="action-buttons">
                    <a href="{{ path('app_reclamation_index') }}" class="btn btn-back">
                        <i class="bi bi-arrow-left-circle"></i> Retour à la liste
                    </a>
                    <a href="{{ path('app_reclamation_edit', {'idReclamation': reclamation.idReclamation}) }}" class="btn btn-orange">
                        <i class="mdi mdi-pencil"></i> Modifier
                    </a>
                    {{ include('reclamation/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="{{ asset('js/bootstrap.bundle.min.js') }}"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
    <script>
        AOS.init({
            duration: 800,
            once: true
        });

        document.addEventListener('DOMContentLoaded', () => {
            // Animation on button click
            document.querySelectorAll('.btn-orange, .btn-back').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    if (!this.classList.contains('delete-btn')) {
                        e.preventDefault();
                        const href = this.getAttribute('href');
                        this.style.transition = 'transform 0.2s ease';
                        this.style.transform = 'scale(0.95)';
                        setTimeout(() => {
                            this.style.transform = 'scale(1)';
                            if (href) {
                                window.location.href = href;
                            }
                        }, 100);
                    }
                });
            });
        });
    </script>
{% endblock %}