{% extends 'base.html.twig' %}

{% block title %}Détails de la Réclamation{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-orange: #F57C00;
            --primary-blue: #041E42;
            --background-light: #F5F5F5;
            --text-dark: #333333;
            --text-muted: #6c757d;
            --white-color: #ffffff;
            --danger-red: #dc3545;
            --success-green: #28a745;
            --warning-yellow: #ffc107;
        }

        .show-reclamation-section {
            background: linear-gradient(135deg, var(--primary-blue) 0%, #1B263B 100%);
            min-height: 100vh;
            padding: 4rem 1rem;
            color: var(--white-color);
            font-family: 'Nunito', sans-serif;
        }

        .details-container {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 1.5rem;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
            backdrop-filter: blur(10px);
            max-width: 800px;
            margin: 2rem auto;
            padding: 2.5rem;
        }

        .section-header {
            text-align: center;
            margin-bottom: 2.5rem;
        }

        .section-header h1 {
            font-size: 2.5rem;
            color: var(--primary-orange);
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.1);
        }

        .details-table {
            width: 100%;
            margin: 1.5rem 0;
        }

        .details-table th {
            color: var(--primary-blue);
            font-weight: 700;
            padding: 1rem;
            width: 30%;
            vertical-align: top;
        }

        .details-table td {
            color: var(--text-dark);
            padding: 1rem;
            position: relative;
        }

        .audio-control {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: var(--primary-orange);
            color: white;
            padding: 0.5rem 1rem;
            border-radius: 2rem;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .audio-control:hover {
            background: #E06B00;
            transform: translateY(-2px);
        }

        .audio-control i {
            font-size: 1.2rem;
        }

        .status-badge {
            padding: 0.4rem 1rem;
            border-radius: 1rem;
            font-weight: 600;
            display: inline-block;
        }

        .action-buttons {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: var(--primary-orange);
            color: white;
            padding: 0.5rem 1rem;
            border-radius: 2rem;
            cursor: pointer;
            transition: all 0.3s ease;
            
        }

        .action-buttons:hover {
            background: #E06B00;
            transform: translateY(-2px);
        }

        .action-buttons i {
            font-size: 1.2rem;
        }

        
        @media (max-width: 768px) {
            .details-container {
                padding: 1.5rem;
            }
            
            .section-header h1 {
                font-size: 2rem;
            }
            
            .details-table th, 
            .details-table td {
                display: block;
                width: 100%;
                padding: 0.5rem;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <section class="show-reclamation-section">
        <div class="container" data-aos="fade-up">
            <div class="section-header">
                <h1>Détails de la Réclamation</h1>
                <div class="title-underline"></div>
            </div>

            <div class="details-container" data-aos="fade-up" data-aos-delay="100">
                <table class="details-table">
                    <tbody>
                    
                        <tr>
                            <th>Sujet</th>
                            <td>{{ reclamation.sujet }}</td>
                        </tr>
                        <tr>
                            <th>Description</th>
                            <td>{{ reclamation.Description }}</td>
                        </tr>
                        <tr>
                            <th>Date de Réclamation</th>
                            <td>{{ reclamation.dateReclamation ? reclamation.dateReclamation|date('d/m/Y') : 'Non définie' }}</td>
                        </tr>
                        <tr>
                            <th>Statut</th>
                            <td>
                                <span class="status-badge status-{{ reclamation.statut|lower }}">
                                    {{ reclamation.statut }}
                                </span>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <div class="action-buttons">
                    <a href="{{ path('app_reclamation_index') }}" class="btn btn-back">
                        <i class="bi bi-arrow-left-circle"></i> Retour à la liste
                    </a>
                    {{ include('reclamation/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block js %}
    {{ parent() }}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
    <script>
        AOS.init({
            duration: 800,
            once: true
        });

        
    </script>
{% endblock %}
