{% extends 'base.html.twig' %}

{% block title %}Détails de la Réclamation{% endblock %}

{% block css %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root {
            --primary-orange: #F57C00;
            --primary-blue: #041E42;
            --background-light: #F5F5F5;
            --text-dark: #333333;
            --text-muted: #6c757d;
            --white-color: #ffffff;
            --shadow-sm: 0 4px 15px rgba(0, 0, 0, 0.1);
            --shadow-lg: 0 10px 30px rgba(0, 0, 0, 0.15);
            --danger-red: #dc3545;
            --success-green: #28a745;
            --warning-yellow: #ffc107;
        }

        .show-reclamation-section {
            background: linear-gradient(160deg, var(--primary-blue) 0%, #1e293b 100%);
            padding: 80px 0;
            min-height: 100vh;
            color: var(--white-color);
            position: relative;
            overflow: hidden;
        }

        .section-header {
            margin-bottom: 40px;
            text-align: center;
        }
        .section-header h1 {
            font-size: 2.5rem;
            font-weight: 800;
            color: var(--primary-orange);
            text-transform: uppercase;
            letter-spacing: 1px;
            text-shadow: 2px 2px 10px rgba(245, 124, 0, 0.3);
        }
        .title-underline {
            width: 80px;
            height: 4px;
            background: var(--primary-orange);
            border-radius: 2px;
            margin: 15px auto;
            transition: width 0.3s ease;
        }
        .section-header:hover .title-underline {
            width: 120px;
        }

        .details-container {
            background: var(--white-color);
            border-radius: 20px;
            box-shadow: var(--shadow-lg);
            padding: 40px;
            max-width: 700px;
            margin: 0 auto;
        }

        .details-table {
            width: 100%;
            border-collapse: collapse;
        }
        .details-table th,
        .details-table td {
            padding: 15px;
            text-align: left;
            border-bottom: 1px solid var(--background-light);
        }
        .details-table th {
            color: var(--primary-blue);
            font-weight: 600;
            width: 30%;
        }
        .details-table td {
            color: var(--text-dark);
        }
        .status-badge {
            padding: 0.4rem 0.8rem;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 500;
            display: inline-block;
        }
        .status-ouvert { background: var(--warning-yellow); color: #000; }
        .status-encours { background: var(--primary-orange); color: white; }
        .status-fermé { background: var(--success-green); color: white; }

        .btn {
            padding: 10px 20px;
            font-size: 1rem;
            border-radius: 25px;
            text-decoration: none;
            transition: all 0.4s ease;
            font-weight: 600;
            display: inline-block;
            text-align: center;
        }
        .btn-orange {
            background: var(--primary-orange);
            color: var(--white-color);
            box-shadow: var(--shadow-sm);
            border: none;
        }
        .btn-orange:hover {
            background: #e06b00;
            transform: translateY(-2px) scale(1.05);
            box-shadow: 0 6px 15px rgba(245, 124, 0, 0.4);
            color: var(--white-color);
        }
        .btn-danger {
            background: var(--danger-red);
            color: var(--white-color);
            box-shadow: var(--shadow-sm);
            border: none;
        }
        .btn-danger:hover {
            background: #c82333;
            transform: translateY(-2px) scale(1.05);
            box-shadow: 0 6px 15px rgba(220, 53, 69, 0.4);
            color: var(--white-color);
        }
        .btn-back {
            color: var(--primary-orange);
            font-weight: 500;
            transition: color 0.3s ease;
        }
        .btn-back:hover {
            color: #e06b00;
            text-decoration: underline;
        }

        .action-buttons {
            margin-top: 20px;
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            justify-content: center;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .section-header h1 { font-size: 2rem; }
            .details-container { padding: 20px; }
            .details-table th, .details-table td { display: block; width: 100%; }
            .details-table th { padding-bottom: 5px; }
            .btn { font-size: 0.9rem; width: 100%; }
        }
    </style>
{% endblock %}

{% block body %}
    <section class="show-reclamation-section">
        <div class="container" data-aos="fade-up">
            <div class="section-header">
                <h1>Détails de la Réclamation</h1>
                <div class="title-underline"></div>
            </div>

            <div class="details-container" data-aos="fade-up" data-aos-delay="100">
                <table class="details-table">
                    <tbody>
                        <tr>
                            <th>ID Réclamation</th>
                            <td>#{{ reclamation.idReclamation }}</td>
                        </tr>
                        <tr>
                            <th>Sujet</th>
                            <td>{{ reclamation.sujet }}</td>
                        </tr>
                        <tr>
                            <th>Description</th>
                            <td>{{ reclamation.description }}</td>
                        </tr>
                        <tr>
                            <th>Date de Réclamation</th>
                            <td>{{ reclamation.dateReclamation ? reclamation.dateReclamation|date('d/m/Y') : 'Non définie' }}</td>
                        </tr>
                        <tr>
                            <th>Statut</th>
                            <td>
                                <span class="status-badge status-{{ reclamation.statut|lower }}">
                                    {{ reclamation.statut }}
                                </span>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <div class="action-buttons">
                    <a href="{{ path('app_reclamation_index') }}" class="btn btn-back">
                        <i class="bi bi-arrow-left-circle"></i> Retour à la liste
                    </a>
                    {{ include('reclamation/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block js %}
    {{ parent() }}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
    <script>
        AOS.init({
            duration: 800,
            once: true
        });
    </script>
{% endblock %}