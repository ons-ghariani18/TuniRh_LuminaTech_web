{% extends 'base.html.twig' %}

{% block title %}Créer une Nouvelle Réclamation{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://cdn.materialdesignicons.com/5.4.55/css/materialdesignicons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-blue: #1B263B;
            --primary-orange: #F57C00;
            --orange-light: #F28C38;
            --background-dark: #0B1322;
            --card-bg: #FFFFFF;
            --text-dark: #2D3142;
            --text-light: #F5F6F5;
            --text-muted: #6c757d;
            --shadow-sm: 0 4px 12px rgba(0, 0, 0, 0.15);
            --shadow-lg: 0 12px 30px rgba(0, 0, 0, 0.2);
            --transition: all 0.3s ease;
            --border-color: #E5E7EB;
            --success-green: #28a745;
            --warning-yellow: #ffc107;
            --danger-red: #dc3545;
        }

        body {
            font-family: 'Nunito', sans-serif;
            background: linear-gradient(45deg, var(--background-dark), var(--primary-blue));
            color: var(--text-dark);
            margin: 0;
            padding: 0;
            min-height: 100vh;
        }

        .flex { display: flex; }
        .items-center { align-items: center; }
        .justify-between { justify-content: space-between; }
        .gap-2 { gap: 0.5rem; }
        .text-2xl { font-size: 1.5rem; }
        .font-bold { font-weight: 700; }
        .rounded-full { border-radius: 9999px; }
        .mb-6 { margin-bottom: 1.5rem; }
        .mr-2 { margin-right: 0.5rem; }

        .main-content {
            padding: 0;
            width: 100%;
        }

        .content-inner {
            padding: 2rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        .navbar {
            position: sticky;
            top: 0;
            background: var(--card-bg);
            padding: 1rem 2rem;
            display: flex;
            justify-content: flex-end;
            align-items: center;
            box-shadow: var(--shadow-sm);
            z-index: 99;
        }

        .navbar-menu {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .btn-primary {
            background: var(--primary-orange);
            color: var(--text-light);
            padding: 0.5rem 1rem;
            border-radius: 8px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.3s ease;
            text-decoration: none;
            border: none;
            cursor: pointer;
            box-shadow: var(--shadow-sm);
        }

        .btn-primary:hover {
            background: var(--orange-light);
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(231, 111, 81, 0.5);
        }

        .btn-secondary {
            background: #6c757d;
            color: var(--text-light);
            padding: 0.5rem 1rem;
            border-radius: 8px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.3s ease;
            text-decoration: none;
            border: none;
            cursor: pointer;
            box-shadow: var(--shadow-sm);
        }

        .btn-secondary:hover {
            background: #5a6268;
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(108, 117, 125, 0.5);
        }

        .form-container {
            max-width: 700px;
            margin: 2rem auto;
            padding: 2rem;
            background: var(--card-bg);
            border-radius: 10px;
            box-shadow: var(--shadow-lg);
        }

        .section-header {
            text-align: center;
            margin-bottom: 2rem;
        }

        .section-header h1 {
            font-size: 2rem;
            font-weight: 700;
            color: var(--primary-orange);
            text-transform: uppercase;
        }

        .section-header .title-underline {
            width: 100px;
            height: 4px;
            background: var(--primary-orange);
            margin: 1rem auto;
            border-radius: 2px;
            transition: width 0.3s ease;
        }

        .section-header:hover .title-underline {
            width: 140px;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-group label {
            display: block;
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 0.5rem;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            font-family: 'Nunito', sans-serif;
            font-size: 1rem;
            transition: border-color 0.3s ease, box-shadow 0.3s ease;
        }

        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            border-color: var(--primary-orange);
            box-shadow: 0 0 8px rgba(231, 111, 81, 0.3);
            outline: none;
        }

        .form-actions {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 1rem;
            margin-top: 2rem;
        }

        .flash-message {
            padding: 1rem;
            margin-bottom: 1rem;
            border-radius: 8px;
            text-align: center;
            font-weight: 600;
        }

        .flash-message.danger {
            background: var(--danger-red);
            color: var(--text-light);
        }

        .flash-message.success {
            background: var(--success-green);
            color: var(--text-light);
        }

        .form-errors {
            color: var(--danger-red);
            font-size: 0.9rem;
            margin-top: 0.25rem;
        }

        @media (max-width: 768px) {
            .content-inner {
                padding: 1rem;
            }

            .navbar {
                padding: 1rem;
                justify-content: center;
            }

            .form-container {
                margin: 1rem;
                padding: 1rem;
            }

            .section-header h1 {
                font-size: 1.5rem;
            }

            .form-actions {
                flex-direction: column;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="main-content">
    <header class="navbar wow fadeInDown" data-wow-delay="0.2s">
        <div class="navbar-menu">
            <div class="flex items-center gap-2">
                <img src="https://ui-avatars.com/api/?name=RH+Admin&background=091E3E&color=fff" class="rounded-full" width="36" alt="Admin Avatar">
                <span>Admin RH</span>
            </div>
        </div>
    </header>

    <div class="content-inner">
        <div class="form-container wow fadeInUp" data-wow-delay="0.3s">
            <div class="section-header">
                <h1>Créer une Nouvelle Réclamation</h1>
                <div class="title-underline"></div>
            </div>

            {# Messages flash - Ajoutez ce bloc #}
            {% for message in app.flashes('error') %}
                <div class="flash-message danger wow fadeIn" data-wow-delay="0.2s">
                    {{ message }}
                </div>
            {% endfor %}

            
            {% for flash_message in app.flashes('success') %}
                <div class="flash-message success wow fadeIn" data-wow-delay="0.2s">
                    {{ flash_message }}
                </div>
            {% endfor %}

            {{ form_start(form) }}
                <div class="form-group">
                    {{ form_label(form.sujet) }}
                    {{ form_widget(form.sujet) }}
                    {{ form_errors(form.sujet) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.description) }}
                    {{ form_widget(form.description) }}
                    {{ form_errors(form.description) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.dateReclamation) }}
                    {{ form_widget(form.dateReclamation) }}
                    {{ form_errors(form.dateReclamation) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.statut) }}
                    {{ form_widget(form.statut) }}
                    {{ form_errors(form.statut) }}
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">
                        <i class="mdi mdi-message-alert mr-2"></i> {{ button_label|default('Créer la réclamation') }}
                    </button>
                </div>
            {{ form_end(form) }}

            <div class="form-actions wow fadeInUp" data-wow-delay="0.4s">
                <a href="{{ path('app_reclamation_index') }}" class="btn btn-secondary" title="Retour à la liste">
                    <i class="mdi mdi-arrow-left mr-2"></i> Retour à la liste
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        new WOW().init();

        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.btn-primary, .btn-secondary').forEach(button => {
                button.addEventListener('click', function(e) {
                    if (this.tagName === 'A') {
                        e.preventDefault();
                        const href = this.getAttribute('href');
                        this.style.transition = 'transform 0.2s ease';
                        this.style.transform = 'scale(0.95)';
                        setTimeout(() => {
                            this.style.transform = 'scale(1)';
                            window.location.href = href;
                        }, 100);
                    }
                });
            });

            document.querySelectorAll('[title]').forEach(element => {
                new bootstrap.Tooltip(element);
            });
        });
    </script>
{% endblock %}