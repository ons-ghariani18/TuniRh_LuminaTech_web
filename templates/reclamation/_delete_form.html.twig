<form method="post" action="{{ path('app_reclamation_delete', {'idReclamation': reclamation.idReclamation}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cette réclamation ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reclamation.idReclamation) }}">
    <button type="submit" class="btn btn-danger delete-btn">
        <i class="bi bi-trash"></i> Supprimer
    </button>
</form>