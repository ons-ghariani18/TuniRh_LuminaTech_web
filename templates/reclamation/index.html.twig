{% extends 'base.html.twig' %}

{% block title %}Gestion des Réclamations{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://cdn.materialdesignicons.com/5.4.55/css/materialdesignicons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
    <!-- Font Awesome pour les icônes du navbar -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <!-- Bootstrap CSS pour le navbar -->
    <link rel="stylesheet" href="{{ asset('css/bootstrap.min.css') }}">

    <style>
        :root {
            --primary-blue: #1B263B;
            --primary-orange: #E76F51;
            --orange-light: #F28C38;
            --background-dark: #0B1322;
            --card-bg: #FFFFFF;
            --text-dark: #2D3142;
            --text-light: #F5F6F5;
            --text-muted: #6c757d;
            --shadow-sm: 0 4px 12px rgba(0, 0, 0, 0.15);
            --shadow-lg: 0 12px 30px rgba(0, 0, 0, 0.2);
            --transition: all 0.3s ease;
            --border-color: #E5E7EB;
            --success-green: #28a745;
            --warning-yellow: #ffc107;
            --danger-red: #dc3545;
            /* Variables pour le navbar */
            --navbar-primary: #e67e22 !important; /* Orange chaleureux */
            --navbar-primary-hover: #d35400 !important; /* Orange foncé */
            --navbar-secondary: #3498db !important; /* Bleu clair */
            --navbar-secondary-hover: #2980b9 !important; /* Bleu foncé */
            --navbar-light: #f5f7fa !important; /* Gris très clair */
            --navbar-dark: #091E3E !important; /* Bleu marine */
        }

        body {
            font-family: 'Nunito', sans-serif;
            background: linear-gradient(45deg, var(--background-dark), var(--primary-blue));
            color: var(--text-dark);
            margin: 0;
            padding: 0;
            min-height: 100vh;
        }

        .flex { display: flex; }
        .flex-1 { flex: 1; }
        .items-center { align-items: center; }
        .justify-between { justify-content: space-between; }
        .gap-2 { gap: 0.5rem; }
        .gap-4 { gap: 1rem; }
        .text-xl { font-size: 1.25rem; }
        .text-2xl { font-size: 1.5rem; }
        .font-bold { font-weight: 700; }
        .rounded-full { border-radius: 9999px; }
        .mb-6 { margin-bottom: 1.5rem; }
        .mr-2 { margin-right: 0.5rem; }

        /* Main Content */
        .main-content {
            padding: 0;
            width: 100%;
        }

        .content-inner {
            padding: 2rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        .search-input {
            padding: 0.5rem 1rem;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            width: 250px;
            font-family: 'Nunito', sans-serif;
            transition: border-color 0.3s ease, box-shadow 0.3s ease;
        }

        .search-input:focus {
            border-color: var(--primary-orange);
            box-shadow: 0 0 8px rgba(231, 111, 81, 0.3);
            outline: none;
        }

        /* Button & Table */
        .btn-primary {
            background: var(--primary-orange);
            color: var(--text-light);
            padding: 0.5rem 1rem;
            border-radius: 8px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.3s ease;
            text-decoration: none;
            border: none;
            cursor: pointer;
            box-shadow: var(--shadow-sm);
        }

        .btn-primary:hover {
            background: var(--orange-light);
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(231, 111, 81, 0.5);
        }

        .table-container {
            margin-top: 2rem;
            background: var(--card-bg);
            padding: 1.5rem;
            border-radius: 10px;
            box-shadow: var(--shadow-lg);
            overflow-x: auto;
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
        }

        .data-table th, .data-table td {
            text-align: left;
            padding: 0.75rem 1rem;
            border-bottom: 1px solid var(--border-color);
        }

        .data-table th {
            background: linear-gradient(135deg, var(--primary-blue), var(--primary-blue) 60%, var(--primary-orange));
            color: var(--text-light);
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .data-table td {
            color: var(--text-dark);
        }

        .data-table tr:last-child td {
            border-bottom: none;
        }

        .data-table tr:hover {
            background: #F1F5F9;
            transition: background 0.3s ease;
        }

        .action-link {
            color: var(--primary-orange);
            margin-right: 0.5rem;
            text-decoration: none;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            transition: color 0.3s ease;
        }

        .action-link:hover {
            color: var(--orange-light);
            text-decoration: underline;
        }

        .no-records {
            text-align: center;
            color: var(--text-muted);
            padding: 1rem;
            font-size: 1.1rem;
        }

        /* Badge Styling */
        .badge {
            padding: 0.5rem 1rem;
            border-radius: 9999px;
            font-size: 0.875rem;
            font-weight: 600;
        }

        .badge.bg-status-ouvert {
            background: var(--warning-yellow);
            color: #000;
        }

        .badge.bg-status-encours {
            background: var(--primary-orange);
            color: var(--text-light);
        }

        .badge.bg-status-ferme {
            background: var(--success-green);
            color: var(--text-light);
        }

        /* Styles pour le nouveau navbar */
        .navbar-dark .navbar-nav .nav-link {
            color: #fff !important;
            transition: color 0.3s ease;
        }

        .navbar-dark .navbar-nav .nav-link:hover,
        .navbar-dark .navbar-nav .nav-link.active {
            color: var(--navbar-primary) !important;
        }

        .navbar-dark .navbar-toggler {
            color: var(--navbar-primary) !important;
            border-color: var(--navbar-primary) !important;
        }

        .dropdown-menu.bg-dark {
            background-color: var(--navbar-dark) !important;
            border: none;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }

        .dropdown-item.text-white {
            color: #fff !important;
            transition: all 0.3s ease;
        }

        .dropdown-item.hover-orange:hover {
            background-color: #ff8c00 !important;
            color: white !important;
        }

        .btn-outline-primary {
            color: var(--navbar-primary) !important;
            border-color: var(--navbar-primary) !important;
            background-color: transparent !important;
            transition: all 0.3s ease;
        }

        .btn-outline-primary:hover {
            background-color: var(--navbar-primary) !important;
            color: #fff !important;
        }

        .btn-primary.navbar-btn {
            background-color: var(--navbar-primary) !important;
            border-color: var(--navbar-primary) !important;
            color: #fff !important;
            transition: all 0.3s ease;
        }

        .btn-primary.navbar-btn:hover {
            background-color: var(--navbar-primary-hover) !important;
            border-color: var(--navbar-primary-hover) !important;
        }

        .hover-orange {
            transition: color 0.3s ease;
        }

        .hover-orange:hover {
            color: var(--navbar-primary) !important;
        }

        .hover-orange-btn {
            transition: color 0.3s ease;
        }

        .hover-orange-btn:hover {
            color: var(--navbar-primary-hover) !important;
        }

        .dropdown-toggle::after {
            margin-left: 0.5rem;
        }

        .dropdown-menu-end {
            right: 0;
            left: auto;
        }

        @media (max-width: 991px) {
            .navbar-nav {
                padding-top: 1rem;
            }

            .d-flex.ms-3 {
                margin-top: 1rem;
                justify-content: center;
            }
        }

        /* Responsive pour la page */
        @media (max-width: 768px) {
            .content-inner {
                padding: 1rem;
            }

            .search-input {
                width: 100%;
                max-width: 100%;
            }

            .data-table th, .data-table td {
                padding: 0.5rem;
                font-size: 0.9rem;
            }

            .data-table th { display: none; }

            .data-table tbody td {
                display: block;
                text-align: right;
                padding: 0.8rem;
            }

            .data-table tbody td::before {
                content: attr(data-label);
                float: left;
                font-weight: 600;
                color: var(--primary-blue);
            }

            .btn-primary {
                width: 100%;
                justify-content: center;
                margin: 10px 0;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark px-5 py-3 py-lg-0 bg-dark">
        <div class="container-fluid">
            <a href="{{ path('app_home') }}" class="navbar-brand p-0">
                <h1 class="m-0"><i class="fa fa-building me-2"></i>TuniRH</h1>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                <span class="fa fa-bars"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarCollapse">
                <div class="navbar-nav ms-auto py-0">
                    <a href="{{ path('app_home') }}" class="nav-item nav-link hover-orange">Home</a>
                    <a href="{{ path('app_about') }}" class="nav-item nav-link hover-orange">About</a>
                    <div class="nav-item dropdown">
                        <a href="#" class="nav-link dropdown-toggle hover-orange" data-bs-toggle="dropdown">Services</a>
                        <div class="dropdown-menu m-0 bg-dark">
                            <a href="{{ path('app_offres_index') }}" class="dropdown-item text-white hover-orange">Recrutement</a>
                            <a href="{{ path('app_formation') }}" class="dropdown-item text-white hover-orange">Formation</a>
                            <a href="{{ path('app_reclamation_index') }}" class="dropdown-item text-white hover-orange">Réclamation</a>
                        </div>
                    </div>
                    <div class="nav-item dropdown">
                        <a href="#" class="nav-link dropdown-toggle hover-orange" data-bs-toggle="dropdown">Resources</a>
                        <div class="dropdown-menu m-0 bg-dark">
                            <a href="{{ path('app_team') }}" class="dropdown-item text-white hover-orange">Our Team</a>
                            <a href="{{ path('app_testimonials') }}" class="dropdown-item text-white hover-orange">Testimonials</a>
                            <a href="{{ path('app_evenement_index') }}" class="dropdown-item text-white hover-orange">Our Events</a>
                            <a href="{{ path('app_sponsor_index') }}" class="dropdown-item text-white hover-orange">Our Sponsors</a>
                        </div>
                    </div>
                    <a href="{{ path('app_contact') }}" class="nav-item nav-link hover-orange">Contact</a>
                </div>
                <div class="d-flex ms-3">
                    <button type="button" class="btn text-primary hover-orange-btn" data-bs-toggle="modal" data-bs-target="#searchModal">
                        <i class="fa fa-search"></i>
                    </button>
                    {% if app.user %}
                        <div class="dropdown ms-3">
                            <button class="btn btn-primary navbar-btn dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown">
                                <i class="fa fa-user me-1"></i> {{ app.user.email }}
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="#">Mon profil</a></li>
                                <li><a class="dropdown-item" href="{{ path('app_logout') }}">Déconnexion</a></li>
                            </ul>
                        </div>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="btn btn-outline-primary ms-3">Log in</a>
                        <a href="{{ path('app_register') }}" class="btn btn-primary navbar-btn ms-2">Sign up</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </nav>

    <!-- Modal de recherche -->
    <div class="modal fade" id="searchModal" tabindex="-1">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content" style="background: rgba(9, 30, 62, .7);">
                <div class="modal-header border-0">
                    <button type="button" class="btn bg-white btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body d-flex align-items-center justify-content-center">
                    <div class="input-group" style="max-width: 600px;">
                        <input type="text" class="form-control bg-transparent border-primary p-3" placeholder="Type search keyword">
                        <button class="btn btn-primary navbar-btn px-4"><i class="bi bi-search"></i></button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Contenu original de la page (sans l'ancienne barre) -->
    <div class="main-content">
        <div class="content-inner">
            <div class="flex justify-between items-center mb-6 wow fadeInUp" data-wow-delay="0.3s">
                <h1 class="text-2xl font-bold" style="color: var(--primary-orange);">Gestion des Réclamations</h1>
                <a href="{{ path('app_reclamation_new') }}" class="btn-primary">
                    <i class="mdi mdi-plus-circle"></i> Nouvelle Réclamation
                </a>
            </div>

            {% if reclamations is empty %}
                <div class="no-records wow fadeInUp" data-wow-delay="0.4s">Aucune réclamation trouvée</div>
            {% else %}
                <div class="table-container wow fadeInUp" data-wow-delay="0.4s">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Sujet</th>
                                <th>Description</th>
                                <th>Date</th>
                                <th>Statut</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for reclamation in reclamations %}
                                <tr class="wow fadeInUp" data-wow-delay="{{ loop.index0 * 50 }}ms">
                                    <td data-label="Sujet">{{ reclamation.sujet }}</td>
                                    <td data-label="Description">{{ reclamation.description|slice(0, 50) }}...</td>
                                    <td data-label="Date">{{ reclamation.dateReclamation|date('d/m/Y') }}</td>
                                    <td data-label="Statut">
                                        <span class="badge bg-status-{{ reclamation.statut|lower }}">
                                            {{ reclamation.statut }}
                                        </span>
                                    </td>
                                    <td class="action-buttons">
                                        <a href="{{ path('app_reclamation_show', {'idReclamation': reclamation.idReclamation}) }}" 
                                           class="action-link" title="Détails">
                                            <i class="mdi mdi-eye"></i> Voir
                                        </a>
                                        <a href="{{ path('app_reclamation_edit', {'idReclamation': reclamation.idReclamation}) }}" 
                                           class="action-link" title="Modifier">
                                            <i class="mdi mdi-pencil"></i> Modifier
                                        </a>
                                        <a href="#" class="action-link delete-reclamation" 
                                           data-reclamation-name="{{ reclamation.sujet }}" 
                                           data-delete-url="{{ path('app_reclamation_delete', {'idReclamation': reclamation.idReclamation}) }}"
                                           data-token="{{ csrf_token('delete' ~ reclamation.idReclamation) }}"
                                           title="Supprimer">
                                            <i class="mdi mdi-delete"></i> Supprimer
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <!-- jQuery pour Bootstrap -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <!-- Bootstrap JS -->
    <script src="{{ asset('js/bootstrap.bundle.min.js') }}"></script>
    <script>
        new WOW().init();

        document.addEventListener('DOMContentLoaded', () => {
            // Handle delete confirmation
            document.querySelectorAll('.delete-reclamation').forEach(link => {
                link.addEventListener('click', e => {
                    e.preventDefault();
                    const name = link.dataset.reclamationName;
                    const deleteUrl = link.dataset.deleteUrl;
                    const token = link.dataset.token;
                    
                    if (confirm(`Supprimer la réclamation "${name}" ? Cette action est irréversible.`)) {
                        const form = document.createElement('form');
                        form.method = 'POST';
                        form.action = deleteUrl;
                        const tokenInput = document.createElement('input');
                        tokenInput.type = 'hidden';
                        tokenInput.name = '_token';
                        tokenInput.value = token;
                        form.appendChild(tokenInput);
                        document.body.appendChild(form);
                        form.submit();
                    }
                });
            });

            // Animation de clic sur les liens d'action
            document.querySelectorAll('.action-link, .btn-primary').forEach(link => {
                link.addEventListener('click', function(e) {
                    if (!this.classList.contains('delete-reclamation')) {
                        e.preventDefault();
                        const href = this.getAttribute('href');
                        this.style.transition = 'transform 0.2s ease';
                        this.style.transform = 'scale(0.95)';
                        setTimeout(() => {
                            this.style.transform = 'scale(1)';
                            window.location.href = href;
                        }, 100);
                    }
                });
            });

            // Ajout de tooltips
            document.querySelectorAll('[title]').forEach(element => {
                new bootstrap.Tooltip(element);
            });
        });
    </script>
{% endblock %}