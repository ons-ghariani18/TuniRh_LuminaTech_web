{% extends 'base.html.twig' %}

{% block body %}
    <h1>Mes événements Google Calendar</h1>

    {% if events is empty %}
        <p>Aucun événement à afficher.</p>
    {% else %}
        <table>
            <thead>
                <tr>
                    <th>Résumé</th>
                    <th>Date de début</th>
                    <th>Date de fin</th>
                </tr>
            </thead>
            <tbody>
                {% for event in events %}
                    <tr>
                        <td>{{ event.summary }}</td>
                        <td>{{ event.start.dateTime ? event.start.dateTime : event.start.date }}</td>
                        <td>{{ event.end.dateTime ? event.end.dateTime : event.end.date }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
