{% extends 'base.html.twig' %}

{% block title %}Google Calendar{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>Google Calendar</h1>
    
    <div class="alert alert-success">
        You've successfully connected to your Google Calendar!
    </div>
    
    <div class="card">
        <div class="card-header">
            Your Calendar Events
        </div>
        <div class="card-body">
            {# Here you would display events fetched from Google Calendar #}
            <p>Your events will be displayed here.</p>
        </div>
    </div>
    
    <a href="{{ path('google_connect') }}" class="btn btn-primary mt-3">
        Reconnect to Google Calendar
    </a>
</div>
{% endblock %}