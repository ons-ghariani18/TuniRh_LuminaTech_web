{% extends 'base.html.twig' %}

{% block title %}Blog{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('lib/owlcarousel/assets/owl.carousel.min.css') }}">
    <link rel="stylesheet" href="{{ asset('lib/animate/animate.min.css') }}">
    <style>
        :root {
            --primary: #e67e22 !important;
            --primary-hover: #d35400 !important;
            --secondary: #3498db !important;
            --secondary-hover: #2980b9 !important;
            --light: #f5f7fa !important;
            --dark: #091E3E !important;
        }

        /* Couleurs de texte et de fond pour les boutons */
        .btn-primary {
            background-color: var(--primary) !important;
            border-color: var(--primary) !important;
            color: #fff !important;
        }
        .btn-primary:hover {
            background-color: var(--primary-hover) !important;
            border-color: var(--primary-hover) !important;
        }
        .btn-info {
            background-color: var(--secondary) !important;
            border-color: var(--secondary) !important;
            color: #fff !important;
        }
        .btn-info:hover {
            background-color: var(--secondary-hover) !important;
            border-color: var(--secondary-hover) !important;
        }
        .btn-danger {
            background-color: red !important;
            color: #fff !important;
        }
    </style>
{% endblock %}

{% block body %}
    <!-- Blog Start -->
    <div class="container-fluid py-5 wow fadeInUp" data-wow-delay="0.1s">
        <div class="container py-5">
            <div class="row g-5">
                <!-- Blog list Start -->
                <div class="col-lg-8">
                    <div class="row g-5">
                        {% for formation in formations %}
                            {# Initialiser les variables #}
                            {% set isReserved = false %}
                            {% set reservationStatus = 'en attente' %}

                            {# Parcourir la liste des réservations transmises depuis le contrôleur #}
                            {% for reservation in reservations %}
                                {% if reservation.formation.id == formation.id %}
                                    {% set isReserved = true %}
                                    {% set reservationStatus = reservation.status %}
                                {% endif %}
                            {% endfor %}

                            <div class="col-md-6 wow slideInUp" data-wow-delay="0.6s">
                                <div class="blog-item bg-light rounded overflow-hidden">
                                    <div class="blog-img position-relative overflow-hidden">
                                        <img class="img-fluid" src="img/blog-1.jpg" alt="">
                                        <a class="position-absolute top-0 start-0 bg-primary text-white rounded-end mt-5 py-2 px-4" href="">Web Design</a>
                                    </div>
                                    <div class="p-4">
                                        <div class="d-flex mb-3">
                                            <small>
                                                <i class="far fa-calendar-alt text-primary me-2"></i>
                                                {{ formation.startDate | date('d/m/Y') }}
                                            </small>
                                            <small>
                                                <i class="far fa-calendar-alt text-primary me-2"></i>
                                                {{ formation.endDate | date('d/m/Y') }}
                                            </small>
                                        </div>
                                        <h4 class="mb-3">{{ formation.title }}</h4>
                                        <p>{{ formation.description }}</p>

                                        {% if isReserved %}
                                            <form action="{{ path('remove_reservation') }}" method="post">
                                                <input type="hidden" name="formation_id" value="{{ formation.id }}">
                                                <button type="submit" class="btn btn-danger">Se désinscrire</button>
                                            </form>
                                            <p>Statut de la réservation : {{ reservationStatus }}</p>
                                        {% else %}
                                            <form action="{{ path('add_reservation') }}" method="post">
                                                <input type="hidden" name="formation_id" value="{{ formation.id }}">
                                                <button type="submit" class="btn btn-info">S'inscrire</button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                        <div class="col-12 wow slideInUp" data-wow-delay="0.1s">
                            <nav aria-label="Page navigation">
                                <ul class="pagination pagination-lg m-0">
                                    <li class="page-item disabled">
                                        <a class="page-link rounded-0" href="#" aria-label="Previous">
                                            <span aria-hidden="true"><i class="bi bi-arrow-left"></i></span>
                                        </a>
                                    </li>
                                    <li class="page-item active"><a class="page-link" href="#">1</a></li>
                                    <li class="page-item"><a class="page-link" href="#">2</a></li>
                                    <li class="page-item"><a class="page-link" href="#">3</a></li>
                                    <li class="page-item">
                                        <a class="page-link rounded-0" href="#" aria-label="Next">
                                            <span aria-hidden="true"><i class="bi bi-arrow-right"></i></span>
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>
                <!-- Blog list End -->

                <!-- Sidebar Start -->
                <div class="col-lg-4">
                    <!-- Search Form Start -->
                    <div class="mb-5 wow slideInUp" data-wow-delay="0.1s">
                        <div class="input-group">
                            <input type="text" class="form-control p-3" placeholder="Keyword">
                            <button class="btn btn-primary px-4"><i class="bi bi-search"></i></button>
                        </div>
                    </div>
                    <!-- Search Form End -->

                    <!-- Category, Recent Post, etc... (votre sidebar) -->
                    <!-- ... -->
                </div>
                <!-- Sidebar End -->
            </div>
        </div>
    </div>
    <!-- Blog End -->
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('public/js/bootstrap.bundle.min.js') }}"></script>
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="{{ asset('lib/wow/wow.min.js') }}"></script>
    <script src="{{ asset('lib/easing/easing.min.js') }}"></script>
    <script src="{{ asset('lib/waypoints/waypoints.min.js') }}"></script>
    <script src="{{ asset('lib/counterup/counterup.min.js') }}"></script>
    <script src="{{ asset('lib/owlcarousel/owl.carousel.min.js') }}"></script>
    <script src="{{ asset('js/main.js') }}"></script>
{% endblock %}
