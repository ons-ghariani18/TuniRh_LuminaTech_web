    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Notifications (inchangé)
            if (!window.notificationSystem) {
                window.notificationSystem = new NotificationSystem();
            }
            document.querySelector('.notification-close')?.addEventListener('click', e => {
                e.preventDefault(); e.stopPropagation();
                document.getElementById('notificationDropdown').classList.remove('show');
            });

            const searchInput = document.getElementById('searchInput');
            const filterLinks = document.querySelectorAll('.filter-link');
            const formationList = document.getElementById('formationList');
            let currentFilter = 'all';

            function formatFormationHTML(f) {
                return `
          <div class="col-md-6 wow slideInUp formation-item" data-wow-delay="0.6s">
            <div class="blog-item bg-light rounded overflow-hidden">
              <div class="blog-img position-relative overflow-hidden">
                <img class="img-fluid" src="${f.imageUrl}" alt="${f.title}">
                <a href="${f.detailPath}" class="position-absolute top-0 start-0 bg-primary text-white rounded-end mt-5 py-2 px-4">
                  ${f.title}
                </a>
              </div>
              <div class="p-4">
                <div class="d-flex mb-3">
                  <small><i class="far fa-calendar-alt text-primary me-2"></i>${f.startDate}</small>
                  <small class="ms-3"><i class="far fa-calendar-alt text-primary me-2"></i>${f.endDate}</small>
                </div>
                <h4 class="mb-3">
                  ${f.cost == 0
                    ? '<span class="badge bg-success">Gratuit</span>'
                    : `<span class="badge bg-primary">${f.cost} €</span>`}
                </h4>
                <p>${f.description}</p>
                <div class="mt-3">
                  ${f.isReserved
                    ? `<form action="{{ path('remove_reservation') }}" method="post" class="d-inline">
                         <input type="hidden" name="formation_id" value="${f.id}">
                         <button type="submit" class="btn btn-danger">Se désinscrire</button>
                       </form>
                       <p class="mt-2">Statut : ${f.status}</p>`
                    : `<form action="{{ path('add_reservation') }}" method="post" class="d-inline">
                         <input type="hidden" name="formation_id" value="${f.id}">
                         <button type="submit" class="btn btn-info">S'inscrire</button>
                       </form>`}
                  <a href="${f.generateQuizPath}" class="btn btn-warning ms-2">
                    <i class="bi bi-trophy me-1"></i> Générer un quiz
                  </a>
                </div>
              </div>
            </div>
          </div>`;
            }

            async function fetchFormations() {
                const params = new URLSearchParams({
                    search: searchInput.value.trim(),
                    price: currentFilter
                });
                const res = await fetch(`{{ path('app_blog') }}?${params}`, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                if (!res.ok) throw new Error('Erreur réseau');
                const data = await res.json();
                formationList.innerHTML = '';
                if (data.length === 0) {
                    formationList.innerHTML = '<p>Aucune formation trouvée.</p>';
                    return;
                }
                data.forEach(f => formationList.innerHTML += formatFormationHTML(f));
            }

            // Debounce search
            let debounceTimer;
            searchInput.addEventListener('input', () => {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(fetchFormations, 500);
            });

            // Filter clicks
            filterLinks.forEach(link => {
                link.addEventListener('click', e => {
                    e.preventDefault();
                    filterLinks.forEach(l => l.classList.remove('active'));
                    link.classList.add('active');
                    currentFilter = link.dataset.filter;
                    fetchFormations();
                });
            });

            // Initial load
            fetchFormations();
        });
    </script>
{% endblock %}
